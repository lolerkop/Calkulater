---
import {
  getCategories,
  localeCatalog,
  localeHome,
  localeMeta,
  locales,
  ui,
  type AlternateLink,
  type Locale,
} from '../lib/i18n';

interface Props {
  locale?: Locale;
  alternates?: AlternateLink[];
}

const { locale = 'ru', alternates = [] } = Astro.props;
const categories = getCategories(locale);
const copy = ui[locale];
const meta = localeMeta[locale];
const currentPath = Astro.url.pathname;
const catalogPath = localeCatalog(locale);
const isAllActive = currentPath.startsWith(catalogPath);
const languageLinks = alternates.filter((item): item is AlternateLink & { locale: Locale } =>
  item.locale !== 'x-default' && locales.includes(item.locale),
);
const languageOptions = locales.map((optionLocale) => ({
  locale: optionLocale,
  link: languageLinks.find((item) => item.locale === optionLocale),
}));
const unavailableLanguage = locale === 'ru'
  ? 'Эквивалент этой страницы на выбранном языке пока недоступен'
  : locale === 'uk'
    ? 'Відповідна версія цієї сторінки вибраною мовою поки недоступна'
    : locale === 'es'
      ? 'La versión equivalente de esta página todavía no está disponible en ese idioma'
      : 'An equivalent version of this page is not available in that language yet';
const navLabel = {
  ru: 'Основная навигация',
  en: 'Main navigation',
  es: 'Navegación principal',
  de: 'Hauptnavigation',
  fr: 'Navigation principale',
  pt: 'Navegação principal',
  it: 'Navigazione principale',
  pl: 'Nawigacja glowna',
  nl: 'Hoofdnavigatie',
  ro: 'Navigare principala',
  id: 'Navigasi utama',
  tr: 'Ana gezinme',
  vi: 'Điều hướng chính',
  cs: 'Hlavní navigace',
  uk: 'Основна навігація',
  sk: 'Hlavná navigácia',
  hu: 'Fő navigáció',
}[locale];
---

{/* Native disclosures keep every category and language reachable without JS. */}
<header class="site-header" data-testid="site-header">
  <div class="header-container">
    <div class="header-grid">
      <a
        href={localeHome(locale)}
        class="header-logo"
        aria-label={`${meta.siteName} - ${copy.home}`}
        data-testid="header-logo-link"
      >
        <span class="brand-mark" aria-hidden="true">C</span>
        <span class="header-brand-name text-fit">
          {meta.siteName}
        </span>
      </a>

      {alternates.length > 0 && (
        <details
          class="header-lang header-menu"
          data-language-switcher
          data-header-menu
          data-testid="header-language-menu"
        >
          <summary class="header-menu-trigger header-language-trigger" aria-label={`${copy.language}: ${meta.label}`} data-testid="header-language-toggle">
            <svg aria-hidden="true" width="18" height="18"><use href="/header-icons.svg#globe" /></svg>
            {meta.shortLabel}
            <span class="header-menu-chevron" aria-hidden="true"></span>
          </summary>
          <div class="header-menu-panel header-language-panel">
            {languageOptions.map((item) => item.link ? (
              <a
                href={item.link.href}
                class:list={[
                  'header-language-option',
                  item.locale === locale && 'bg-accent-50 text-accent',
                ]}
                hreflang={localeMeta[item.locale].htmlLang}
                aria-current={item.locale === locale ? 'page' : undefined}
                data-testid={`header-lang-${item.locale}`}
                data-analytics-event="language_switch_clicked"
                data-analytics-target-locale={item.locale}
              >
                <span>{localeMeta[item.locale].label}</span>
                <span class="header-language-code" aria-hidden="true">{localeMeta[item.locale].shortLabel}</span>
              </a>
            ) : (
              <span
                class="header-language-option header-language-unavailable"
                aria-disabled="true"
                aria-label={`${localeMeta[item.locale].label}: ${unavailableLanguage}`}
                title={unavailableLanguage}
                data-testid={`header-lang-${item.locale}-unavailable`}
              >
                <span>{localeMeta[item.locale].label}</span>
                <span class="header-language-code" aria-hidden="true">{localeMeta[item.locale].shortLabel}</span>
              </span>
            ))}
          </div>
        </details>
      )}

      <nav
        class="header-nav"
        aria-label={navLabel}
        data-testid="header-nav"
      >
        <a
          href={catalogPath}
          class:list={[
            'site-nav-link header-catalog-link',
            isAllActive ? 'bg-accent-50 text-accent' : 'text-ink-700',
          ]}
          aria-current={isAllActive ? 'page' : undefined}
          data-testid="header-nav-all-calculators"
        >
          <span class="md:hidden">{copy.all}</span>
          <span class="hidden md:inline">{copy.allCalculators}</span>
        </a>
        <details class="header-menu header-category-menu" data-header-menu data-testid="header-categories-menu">
          <summary class="header-menu-trigger" data-testid="header-categories-toggle">
            {copy.categories}
            <span class="header-menu-chevron" aria-hidden="true"></span>
          </summary>
          <div class="header-menu-panel header-category-panel" data-testid="header-categories-panel">
            {categories.map((c) => {
              const categoryPath = `/${locale}/${c.slug}/`;
              const isActive = currentPath.startsWith(categoryPath);
              const currentState = isActive
                ? (currentPath === categoryPath ? 'page' : 'location')
                : undefined;
              return (
                <a
                  href={categoryPath}
                  class:list={[
                    'site-nav-link',
                    isActive && 'bg-accent-50 font-semibold text-accent',
                  ]}
                  aria-current={currentState}
                  data-testid={`header-nav-${c.slug}`}
                >
                  {c.name}
                </a>
              );
            })}
          </div>
        </details>
      </nav>
    </div>
  </div>
</header>

<script src="/header-navigation.js" defer is:inline></script>
