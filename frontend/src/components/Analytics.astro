---
import { SITE } from '../config/site';
import type { Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

function isValidGaId(value: string): boolean {
  return /^G-[A-Z0-9]{6,}$/i.test(value) && !/^G-X+$/i.test(value);
}

function isValidYmId(value: string): boolean {
  return /^\d{5,12}$/.test(value) && value !== '12345678' && !/^0+$/.test(value);
}

const locale = Astro.props.locale ?? 'ru';
const language = locale === 'ru' || locale === 'uk' || locale === 'de' || locale === 'es' ? locale : 'en';
const gaId = isValidGaId(SITE.gaId) ? SITE.gaId : '';
const ymId = isValidYmId(SITE.ymId) ? SITE.ymId : '';
const analyticsConfigured = Boolean(gaId || ymId);
const storageKey = 'calcuway.analytics-consent.v1';
const copy = {
  ru: {
    title: 'Настройки аналитики',
    text: 'Google Analytics и Яндекс Метрика включаются только с вашего согласия, если настроены. Для защиты введённых данных эти сервисы не работают на калькуляторах, страницах поиска и ссылках с параметрами. Подробности обработки данных описаны в политике конфиденциальности.',
    accept: 'Разрешить',
    reject: 'Отклонить',
    privacy: 'Политика конфиденциальности',
    settings: 'Настройки приватности',
  },
  en: {
    title: 'Analytics settings',
    text: 'Google Analytics and Yandex Metrica load only with your consent, when configured. To protect entered data, these services stay off on calculators, search pages and links with parameters. Data processing details are explained in the privacy policy.',
    accept: 'Allow',
    reject: 'Reject',
    privacy: 'Privacy policy',
    settings: 'Privacy settings',
  },
  uk: {
    title: 'Налаштування аналітики',
    text: 'Google Analytics і Яндекс Метрика вмикаються лише за вашою згодою, якщо налаштовані. Для захисту введених даних ці сервіси не працюють у калькуляторах, на сторінках пошуку та в посиланнях із параметрами. Докладніше про обробку даних читайте в політиці конфіденційності.',
    accept: 'Дозволити',
    reject: 'Відхилити',
    privacy: 'Політика конфіденційності',
    settings: 'Налаштування приватності',
  },
  es: {
    title: 'Ajustes de analítica',
    text: 'Google Analytics y Yandex Metrica solo se cargan con tu consentimiento, si están configurados. Para proteger los datos introducidos, permanecen desactivados en calculadoras, páginas de búsqueda y enlaces con parámetros. Los detalles del tratamiento de datos se explican en la política de privacidad.',
    accept: 'Permitir',
    reject: 'Rechazar',
    privacy: 'Política de privacidad',
    settings: 'Ajustes de privacidad',
  },
  de: {
    title: 'Analyseeinstellungen',
    text: 'Google Analytics und Yandex Metrica laden nur mit deiner Einwilligung, sofern sie eingerichtet sind. Zum Schutz eingegebener Daten bleiben diese Dienste auf Rechnern, Suchseiten und Links mit Parametern ausgeschaltet. Einzelheiten zur Datenverarbeitung stehen in der Datenschutzerklärung.',
    accept: 'Zulassen',
    reject: 'Ablehnen',
    privacy: 'Datenschutzerklärung',
    settings: 'Datenschutzeinstellungen',
  },
}[language];
---

{analyticsConfigured && (
  <>
    <section
      id="analytics-consent"
      class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-2xl rounded-2xl border border-ink-200 bg-white p-5 shadow-2xl"
      role="dialog"
      aria-modal="false"
      aria-labelledby="analytics-consent-title"
      data-testid="analytics-consent"
      hidden
    >
      <h2 id="analytics-consent-title" class="text-lg font-bold text-ink-900">{copy.title}</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-600">{copy.text}</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" class="rounded-xl bg-accent px-4 py-2 text-sm font-bold text-white" data-analytics-choice="granted">
          {copy.accept}
        </button>
        <button type="button" class="rounded-xl border border-ink-300 px-4 py-2 text-sm font-bold text-ink-800" data-analytics-choice="denied">
          {copy.reject}
        </button>
        <a href={`/${locale}/privacy/#analytics`} class="self-center text-sm font-semibold text-accent underline underline-offset-4">
          {copy.privacy}
        </a>
      </div>
    </section>
    <button
      id="analytics-settings"
      type="button"
      class="fixed bottom-4 left-4 z-40 rounded-xl border border-ink-200 bg-white px-3 py-2 text-xs font-semibold text-ink-700 shadow-lg"
      data-testid="analytics-settings"
      hidden
    >
      {copy.settings}
    </button>
    <script is:inline define:vars={{ gaId, ymId, storageKey }}>
      (() => {
        const banner = document.getElementById('analytics-consent');
        const settings = document.getElementById('analytics-settings');
        let gaLoaded = false;
        let ymLoaded = false;
        let gaLoading = false;
        let ymLoading = false;
        let gaReady = false;
        let ymReady = false;
        let consentGranted = false;
        // Provider account settings can enable automatic URL/form collection.
        // Do not load those libraries at all where this app accepts inputs or
        // changes query parameters. A gtag custom-event allowlist is not enough.
        const canLoadAnalytics = () => {
          const url = new URL(window.location.href);
          const parts = url.pathname.split('/').filter(Boolean);
          const staticPage = parts.length === 2 && ['about', 'contacts', 'privacy'].includes(parts[1]);
          const categoryPage = parts.length === 2 && Boolean(document.querySelector('[data-testid^="category-page-"]'));
          if (!staticPage && !categoryPage) return false;
          if (url.search || url.hash) return false;
          if (document.querySelector('input, select, textarea')) return false;
          if (document.referrer) {
            try {
              const referrer = new URL(document.referrer);
              if (referrer.search || referrer.hash) return false;
            } catch { return false; }
          }
          return true;
        };
        const safePageMetadata = () => {
          const canonical = document.querySelector('link[rel="canonical"]')?.href;
          const page = new URL(canonical || window.location.href);
          return {
            page_location: page.origin + page.pathname,
            page_referrer: document.referrer ? new URL(document.referrer).origin + '/' : '',
            page_title: document.title,
          };
        };
        const allowedEvents = new Set([
          'calculator_view',
          'calculator_input_started',
          'calculator_result_shown',
          'calculator_validation_error',
          'calculator_copy_link_clicked',
          'calculator_copy_link_confirmed',
          'calculator_copy_link_cancelled',
          'language_switch_clicked',
          'related_calculator_clicked',
          'contact_link_clicked',
        ]);
        const allowedMetadata = new Set(['calculator_id', 'locale', 'target_locale', 'target_path']);

        const sendEvent = (name, metadata = {}) => {
          if (!consentGranted || !canLoadAnalytics() || !allowedEvents.has(name)) return;
          const safeMetadata = {};
          for (const [key, value] of Object.entries(metadata ?? {})) {
            if (allowedMetadata.has(key) && typeof value === 'string' && value.length <= 120) {
              if (key === 'target_path') {
                try {
                  const target = new URL(value, window.location.origin);
                  if (target.origin === window.location.origin) safeMetadata[key] = target.pathname;
                } catch {}
              } else if (key === 'locale' || key === 'target_locale') {
                if (['ru', 'en', 'uk', 'de', 'es'].includes(value)) safeMetadata[key] = value;
              } else if (/^[a-z0-9-]{1,80}$/.test(value)) {
                safeMetadata[key] = value;
              }
            }
          }
          if (gaReady && window.gtag) window.gtag('event', name, { ...safeMetadata, ...safePageMetadata() });
          if (ymReady && window.ym) window.ym(Number(ymId), 'reachGoal', name, safeMetadata);
        };

        window.addEventListener('calcuway:analytics', (event) => {
          sendEvent(event.detail?.name, event.detail?.metadata);
        });

        document.addEventListener('click', (event) => {
          const link = event.target.closest?.('[data-analytics-event]');
          if (!link) return;
          const url = link.href ? new URL(link.href, window.location.origin) : null;
          sendEvent(link.dataset.analyticsEvent, {
            locale: document.documentElement.lang,
            target_locale: link.dataset.analyticsTargetLocale || '',
            target_path: url?.origin === window.location.origin ? url.pathname : '',
          });
        });

        const initializeGa = () => {
          if (!consentGranted || !canLoadAnalytics()) return;
          window[`ga-disable-${gaId}`] = false;
          const page = safePageMetadata();
          window.gtag('set', { ...page, allow_google_signals: false, allow_ad_personalization_signals: false });
          window.gtag('config', gaId, {
            ...page,
            send_page_view: false,
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
          });
          window.gtag('event', 'page_view', page);
          gaReady = true;
        };
        const initializeYm = () => {
          if (!consentGranted || !canLoadAnalytics()) return;
          const page = safePageMetadata();
          window.ym(Number(ymId), 'init', {
            defer: true,
            clickmap: false,
            trackLinks: false,
            accurateTrackBounce: false,
            trackHash: false,
            webvisor: false,
            ecommerce: false,
            sendTitle: false,
          });
          window.ym(Number(ymId), 'hit', page.page_location, { title: page.page_title, referer: page.page_referrer });
          ymReady = true;
        };
        const loadAnalytics = () => {
          consentGranted = true;
          if (!canLoadAnalytics()) return;
          if (gaId && gaLoaded) initializeGa();
          else if (gaId && !gaLoading) {
            gaLoading = true;
            window[`ga-disable-${gaId}`] = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            const gaScript = document.createElement('script');
            gaScript.async = true;
            gaScript.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
            gaScript.referrerPolicy = 'no-referrer';
            gaScript.dataset.testid = 'analytics-ga-loader';
            gaScript.onload = () => { gaLoaded = true; gaLoading = false; initializeGa(); };
            gaScript.onerror = () => { gaLoading = false; gaScript.remove(); };
            document.head.appendChild(gaScript);
          }
          if (ymId && ymLoaded) initializeYm();
          else if (ymId && !ymLoading) {
            ymLoading = true;
            window.ym = window.ym || function () { (window.ym.a = window.ym.a || []).push(arguments); };
            window.ym.l = Number(new Date());
            const ymScript = document.createElement('script');
            ymScript.async = true;
            ymScript.src = 'https://mc.yandex.ru/metrika/tag.js';
            ymScript.referrerPolicy = 'no-referrer';
            ymScript.dataset.testid = 'analytics-ym-loader';
            ymScript.onload = () => { ymLoaded = true; ymLoading = false; initializeYm(); };
            ymScript.onerror = () => { ymLoading = false; ymScript.remove(); };
            document.head.appendChild(ymScript);
          }
        };

        const showSettings = () => {
          banner.hidden = true;
          settings.hidden = false;
        };

        const saveChoice = (choice) => {
          try { localStorage.setItem(storageKey, choice); } catch {}
          showSettings();
          if (choice === 'granted') {
            loadAnalytics();
          } else {
            consentGranted = false;
            const hadYmCounter = ymReady;
            gaReady = false;
            ymReady = false;
            if (gaId) window[`ga-disable-${gaId}`] = true;
            if (hadYmCounter && window.ym) window.ym(Number(ymId), 'destruct');
          }
        };

        let savedChoice = '';
        try { savedChoice = localStorage.getItem(storageKey) || ''; } catch {}
        if (savedChoice === 'granted') {
          showSettings();
          loadAnalytics();
        } else if (savedChoice === 'denied') {
          showSettings();
        } else {
          banner.hidden = false;
        }

        banner.querySelectorAll('[data-analytics-choice]').forEach((button) => {
          button.addEventListener('click', () => saveChoice(button.dataset.analyticsChoice));
        });
        settings.addEventListener('click', () => {
          settings.hidden = true;
          banner.hidden = false;
        });
      })();
    </script>
  </>
)}
