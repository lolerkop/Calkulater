---
// Карточка каталога. Разметка перенесена из React-острова: тот же вид, тот же
// порядок узлов.
//
// Перенос сделан ради масштаба. Остров получал все калькуляторы
// сериализованными props, чтобы отрисовать сетку на клиенте, и при 48
// калькуляторах это стоило 33 878 сырых байт на каждой локали каталога — те же
// имена и описания, что уже лежали в HTML, но в кодировке Astro (`&quot;`,
// обёртки `[0, x]`), которую gzip не мог сопоставить с разметкой. Теперь сетку
// рисует Astro один раз, а остров только показывает и прячет уже готовые
// карточки.
//
// Атрибуты `data-*` несут ровно то, чего нет в видимом тексте: ключевые слова,
// идентификатор категории, признаки популярности и новизны. Имя и описание не
// дублируются — контроллер читает их из заголовка и абзаца самой карточки.
// Порядок по алфавиту тоже не дублируется: контроллер получает его из тех же
// заголовков через localeCompare, и атрибут на каждой карточке не нужен.
// Псевдонимы категорий и токены новизны — общие таблицы, они живут в
// контроллере и на карточках не повторяются.
//
// Ни классов-утилит, ни собственного data-testid карточка не несёт: и то и
// другое повторялось сотнями раз. Вид держит общий класс `.catalog-card`,
// а адресуются карточки атрибутом `data-catalog-card` — им и пользуются
// и контроллер, и тесты.

import type { CalculatorDef } from '../lib/types';

type Props = {
  calc: Pick<CalculatorDef, 'id' | 'name' | 'shortDescription' | 'fullPath' | 'keywords' | 'category' | 'popularity' | 'isNew'>;
  categoryName: string;
  newBadge: string;
  popularBadge: string;
  openLabel: string;
};

const { calc, categoryName, newBadge, popularBadge, openLabel } = Astro.props;
const isPopular = calc.popularity >= 80;
---

<a
  href={calc.fullPath}
  class="catalog-card"
  data-catalog-card
  data-category={calc.category}
  data-popular={isPopular ? '1' : '0'}
  data-new={calc.isNew ? '1' : '0'}
  data-keywords={(calc.keywords ?? []).join(' ')}
>
  <div>
    <div class="catalog-card-badges">
      <div class="catalog-card-badges-inner">
        {calc.isNew && (
          <span class="catalog-badge-new">
            {newBadge}
          </span>
        )}
        {isPopular && (
          <span class="catalog-badge-popular">
            {popularBadge}
          </span>
        )}
      </div>
    </div>
    <h3 class="catalog-card-title">
      {calc.name}
    </h3>
    <p class="catalog-card-desc">
      {calc.shortDescription}
    </p>
  </div>

  <div class="catalog-card-foot">
    <span class="catalog-card-cat">
      {categoryName}
    </span>
    <span class="catalog-card-cta">
      {openLabel}
      <svg class="catalog-card-arrow" aria-hidden="true"><use href="#arrow-right"></use></svg>
    </span>
  </div>
</a>
