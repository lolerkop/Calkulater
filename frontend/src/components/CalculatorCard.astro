---
import type { CalculatorDef } from '../lib/types';
import { getCategoryById, ui, type Locale } from '../lib/i18n';

interface Props {
  calc: CalculatorDef;
  locale?: Locale;
  analyticsEvent?: string;
}

const { calc, locale = 'ru', analyticsEvent } = Astro.props;
const category = getCategoryById(calc.category, locale);
const copy = ui[locale];
const isPopular = calc.popularity >= 80;
const isNew = calc.isNew === true;
---

{/* Оформление переехало в global.css: `.calculator-card-shell` и её структурные
    потомки. Строка утилит занимала здесь около восьмисот символов и повторялась
    на КАЖДОМ члене категории; в CSS она платится один раз. Значения выписаны из
    собранной таблицы Tailwind, вид не меняется. Порядок узлов фиксирован —
    шапка, заголовок, описание, подвал — на него опираются селекторы. */}
<a href={calc.fullPath} class="calculator-card-shell" data-analytics-event={analyticsEvent}>
  <div>
    <span>{category?.name}</span>
    <span>
      {isNew ? <span data-testid="calculator-card-new">{copy.newBadge}</span> : null}
      {isPopular ? <span data-testid="calculator-card-popular">{copy.popularBadge}</span> : null}
    </span>
  </div>
  <h3>{calc.name}</h3>
  <p>{calc.shortDescription}</p>
  <div>
    <span>{copy.open}</span>
    <span aria-hidden="true">→</span>
  </div>
</a>
