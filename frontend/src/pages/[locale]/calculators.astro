---
import Layout from '../../components/Layout.astro';
import CatalogPageBody from '../../components/CatalogPageBody.astro';
import {
  getAlternatesForPage,
  isLocale,
  localeCatalog,
  localeHome,
  locales,
  ui,
  type Locale,
} from '../../lib/i18n';
import { catalogPageCount, catalogPageSlice } from '../../lib/catalogPagination';
import { catalogRows, catalogCategoryRows, catalogCounts, catalogJsonLd } from '../../lib/catalogPageData';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const locale = (Astro.props.locale ?? 'ru') as Locale;
if (!isLocale(locale)) return Astro.redirect('/404');

const copy = ui[locale];
const catalogPath = localeCatalog(locale);
const rows = catalogRows(locale);
const pageCount = catalogPageCount(rows.length);
const alternates = getAlternatesForPage(Object.fromEntries(locales.map((item) => [item, `/${item}/calculators/`])));

const jsonLd = catalogJsonLd({
  locale,
  page: 1,
  pageCount,
  catalogPath,
  rows,
  homeLabel: copy.home,
  homePath: localeHome(locale),
  title: copy.catalogTitle,
  description: copy.catalogDescription,
  catalogLabel: copy.allCalculators,
});
---

<Layout
  title={copy.catalogTitle}
  description={copy.catalogDescription}
  canonical={catalogPath}
  locale={locale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <CatalogPageBody
    locale={locale}
    catalogPath={catalogPath}
    page={1}
    pageCount={pageCount}
    total={rows.length}
    rows={catalogPageSlice(rows, 1)}
    categories={catalogCategoryRows(locale)}
    counts={catalogCounts(rows)}
  />
</Layout>
