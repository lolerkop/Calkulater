---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CalculatorCatalog from '../../components/islands/CalculatorCatalog';
import CatalogCard from '../../components/CatalogCard.astro';
import { clientUi } from '../../lib/clientI18n';
import {
  getAlternatesForPage,
  getCalculators,
  getCategories,
  isLocale,
  localeCatalog,
  localeHome,
  locales,
  ui,
  type Locale,
} from '../../lib/i18n';
import {
  breadcrumbsJsonLd,
  collectionPageJsonLd,
  itemListJsonLd,
} from '../../lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const locale = (Astro.props.locale ?? 'ru') as Locale;
if (!isLocale(locale)) return Astro.redirect('/404');

const copy = ui[locale];
const pageCopy = {
  ru: { breadcrumbs: 'Хлебные крошки' },
  en: { breadcrumbs: 'Breadcrumbs' },
  es: { breadcrumbs: 'Migas de pan' },
  de: { breadcrumbs: 'Breadcrumbs' },
  fr: { breadcrumbs: 'Fil d’Ariane' },
  pt: { breadcrumbs: 'Navegação estrutural' },
  it: { breadcrumbs: 'Breadcrumb' },
  pl: { breadcrumbs: 'Nawigacja okruszkowa' },
  nl: { breadcrumbs: 'Kruimelpad' },
  ro: { breadcrumbs: 'Breadcrumb' },
  id: { breadcrumbs: 'Breadcrumb' },
  tr: { breadcrumbs: 'Breadcrumb' },
  vi: { breadcrumbs: 'Breadcrumb' },
  cs: { breadcrumbs: 'Drobečková navigace' },
  uk: { breadcrumbs: 'Навігаційний ланцюжок' },
  sk: { breadcrumbs: 'Omrvinková navigácia' },
  hu: { breadcrumbs: 'Morzsanavigáció' },
}[locale];
const calculators = getCalculators(locale);
const categories = getCategories(locale);
const title = copy.catalogTitle;
const description = copy.catalogDescription;
const catalogPath = localeCatalog(locale);
const alternates = getAlternatesForPage(Object.fromEntries(locales.map((locale) => [locale, `/${locale}/calculators/`])));

const items = calculators.map((calculator) => ({
  name: calculator.name,
  description: calculator.shortDescription,
  path: calculator.fullPath,
}));


// Дубля каталога в <noscript> здесь больше нет. Astro отдаёт остров уже
// отрисованным на сервере: все карточки со ссылками присутствуют в HTML до
// гидратации, поэтому без JS страница оставалась рабочей и так, а второй
// список лишь показывал каждый калькулятор дважды. Измерено: 65 КБ сырых,
// 3,8 КиБ gzip на каждой локали каталога.
const catalogCalculators = calculators.map((calculator) => {
  const category = categories.find((item) => item.id === calculator.category);
  return {
    id: calculator.id,
    name: calculator.name,
    shortDescription: calculator.shortDescription,
    fullPath: calculator.fullPath,
    keywords: calculator.keywords,
    category: calculator.category,
    categoryName: category?.name,
    popularity: calculator.popularity,
    isNew: calculator.isNew,
  };
});

const catalogCategories = categories.map((category) => ({
  id: category.id,
  name: category.name,
  slug: category.slug,
}));

// Сетка выводится в порядке по популярности — том же, что был у острова по
// умолчанию. Позицию по алфавиту контроллер считает сам из заголовков карточек:
// это те же имена и то же сравнение localeCompare, а атрибут на каждой карточке
// стоил бы байтами на каждой из сотен карточек.
const sortedCatalogCalculators = [...catalogCalculators].sort(
  (a, b) => b.popularity - a.popularity || a.name.localeCompare(b.name, locale),
);
const cardCopy = clientUi[locale];

// Сколько калькуляторов перечисляет ItemList каталога. Величина постоянная:
// структурированные данные не должны расти вместе с подборкой.
const catalogItemListSize = 24;

const jsonLd = [
  collectionPageJsonLd({
    name: title,
    description,
    path: catalogPath,
    items,
    locale,
  }),
  itemListJsonLd({
    name: title,
    path: catalogPath,
    // Перечисляется ВЕРХ подборки, а не вся она.
    //
    // Разметка обязана быть достоверным представлением страницы и не смеет
    // объявлять того, чего читатель не видит, — на этом стоит проверка
    // verify-dist-structured-data-scale. Обратного она не требует: объявить
    // меньше показанного можно, и это ровно тот случай. Полный перечень стоил
    // 6,75 КиБ gzip — четверть страницы — и повторял имя, описание и адрес
    // каждой карточки второй раз, тогда как обходчик берёт их из настоящих
    // ссылок в разметке. Ссылки на месте, все до одной; дублирующий их список
    // рос вместе с каталогом и упирался в потолок раньше самого каталога.
    //
    // Берётся начало того же порядка, в котором страница и показывает карточки
    // (по популярности), поэтому список описывает именно то, что видно сверху.
    items: items.slice(0, catalogItemListSize),
  }),
  breadcrumbsJsonLd([
    { label: copy.home, href: localeHome(locale) },
    { label: title, href: catalogPath },
  ]),
];
---

<Layout
  title={title}
  description={description}
  canonical={catalogPath}
  locale={locale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="hero-mesh border-b border-ink-200" data-testid="calculators-page">
    <div class="mx-auto max-w-page px-5 pb-10 pt-9 sm:px-8 sm:pb-14 sm:pt-12">
      <Breadcrumbs
        label={pageCopy.breadcrumbs}
        items={[
          { label: copy.home, href: localeHome(locale) },
          { label: copy.allCalculators },
        ]}
      />

      <div class="mt-5 flex min-w-0 flex-wrap items-baseline gap-3 sm:mt-6 sm:gap-4">
        <span class="font-mono text-fit text-sm text-ink-500">/{locale}/calculators</span>
        <span class="text-fit text-xs uppercase tracking-wider text-ink-500">
          {calculators.length} {copy.instruments}
        </span>
      </div>

      <h1 class="mt-3 text-fit text-4xl font-extrabold leading-tight tracking-[-0.05em] text-ink-900 sm:text-5xl">
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-fit text-base leading-relaxed text-ink-500 sm:mt-4 sm:text-lg">
        {copy.catalogLead}
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-page space-y-10 px-5 py-10 sm:px-8 sm:py-14 sm:space-y-12">
        <section class="space-y-5 sm:space-y-6" data-testid="calculator-catalog">
          <div class="contents">
            <CalculatorCatalog categories={catalogCategories} locale={locale} client:idle />
          </div>

          <div
            id="catalog-results"
            class="grid gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3"
            aria-label={copy.allCalculators}
          >
            {/*
              Стрелка карточки объявляется один раз и переиспользуется через
              <use>: полная разметка иконки повторялась на каждой карточке и
              росла вместе с подборкой.
            */}
            <svg width="0" height="0" aria-hidden="true" style="position:absolute">
              <symbol id="arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
              </symbol>
            </svg>
            {sortedCatalogCalculators.map((calculator) => (
              <CatalogCard
                calc={calculator}
                categoryName={calculator.categoryName ?? calculator.category}
                newBadge={cardCopy.newBadge}
                popularBadge={cardCopy.popularBadge}
                openLabel={cardCopy.open}
              />
            ))}
          </div>
        </section>

    </div>
  </section>
</Layout>
