---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CalculatorCard from '../../../components/CalculatorCard.astro';
import FaqList from '../../../components/FaqList.astro';
import {
  getAlternatesForCategory,
  getCalculatorsByCategory,
  getCategories,
  getCategoriesBySlug,
  isLocale,
  localeCatalog,
  localeHome,
  locales,
  ui,
  type Locale,
} from '../../../lib/i18n';
import {
  breadcrumbsJsonLd,
  collectionPageJsonLd,
  faqJsonLd,
  itemListJsonLd,
} from '../../../lib/seo';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getCategories(locale).map((category) => ({
      params: { locale, category: category.slug },
      props: { locale, categorySlug: category.slug },
    })),
  );
}

const locale = (Astro.props.locale ?? 'ru') as Locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const { categorySlug } = Astro.props as { categorySlug: string };
const copy = ui[locale];
const pageCopy = {
  ru: { breadcrumbs: 'Хлебные крошки' },
  en: { breadcrumbs: 'Breadcrumbs' },
  es: { breadcrumbs: 'Migas de pan' },
  de: { breadcrumbs: 'Breadcrumbs' },
  fr: { breadcrumbs: 'Fil d’Ariane' },
  pt: { breadcrumbs: 'Navegação estrutural' },
  it: { breadcrumbs: 'Breadcrumb' },
  pl: { breadcrumbs: 'Nawigacja okruszkowa' },
  nl: { breadcrumbs: 'Kruimelpad' },
  ro: { breadcrumbs: 'Breadcrumb' },
  id: { breadcrumbs: 'Breadcrumb' },
  tr: { breadcrumbs: 'Breadcrumb' },
  vi: { breadcrumbs: 'Breadcrumb' },
  cs: { breadcrumbs: 'Drobečková navigace' },
  uk: { breadcrumbs: 'Навігаційний ланцюжок' },
  sk: { breadcrumbs: 'Omrvinková navigácia' },
  hu: { breadcrumbs: 'Morzsanavigáció' },
}[locale];
const usefulCopy = locale === 'ru'
  ? {
      heading: 'Что выбрать в этом разделе',
      intro: 'Начните с популярного калькулятора или откройте полный список. Для другой задачи перейдите в соседний раздел.',
      popular: 'Популярные калькуляторы',
      newItems: 'Новые калькуляторы',
      other: 'Другие разделы',
    }
  : locale === 'uk'
    ? {
        heading: 'Що вибрати в цьому розділі',
        intro: 'Почніть із популярного калькулятора або відкрийте повний список. Для іншого завдання перейдіть до сусіднього розділу.',
        popular: 'Популярні калькулятори',
        newItems: 'Нові калькулятори',
        other: 'Інші розділи',
      }
    : {
        heading: 'Choose a calculator in this section',
        intro: 'Start with a popular calculator or browse the full list. For a different task, open a related category.',
        popular: 'Popular calculators',
        newItems: 'New calculators',
        other: 'Other categories',
      };
const category = getCategoriesBySlug(locale)[categorySlug];
if (!category) return Astro.redirect('/404');

const calculators = getCalculatorsByCategory(category.id, locale);
const popularInCategory = calculators
  .slice()
  .sort((a, b) => b.popularity - a.popularity)
  .slice(0, 3);
const newInCategory = calculators
  .filter((calculator) => calculator.isNew)
  .sort((a, b) => b.popularity - a.popularity || a.name.localeCompare(b.name, locale));
const otherCategories = getCategories(locale).filter((item) => item.id !== category.id);
const calculatorItems = calculators.map((calculator) => ({
  name: calculator.name,
  description: calculator.shortDescription,
  path: calculator.fullPath,
}));
const categoryPath = `/${locale}/${category.slug}/`;
const alternates = getAlternatesForCategory(category.id);

// Сколько калькуляторов перечисляет ItemList раздела. Величина постоянная:
// структурированные данные не должны расти вместе с разделом. Ровно та же
// величина, что и у каталога.
const categoryItemListSize = 24;

const jsonLd = [
  collectionPageJsonLd({
    name: category.h1,
    description: category.seoDescription,
    path: categoryPath,
    items: calculatorItems,
    locale,
  }),
  itemListJsonLd({
    name: `${category.name}: ${copy.allCalculators}`,
    path: categoryPath,
    // Перечисляется ВЕРХ раздела, а не весь он — тем же решением и по той же
    // причине, что и в каталоге.
    //
    // Раздел обязан вывести всех своих членов настоящими ссылками, и он их
    // выводит: ни одна не убрана. Но ItemList повторял имя, адрес и описание
    // КАЖДОГО члена второй раз, и этот повтор рос вместе с сайтом: на
    // подлинных текстах развёрнутая запись стоила около 87 B gzip на члена,
    // плоская — около 25. Обходчик берёт имена и адреса из самих ссылок, так
    // что второй экземпляр списка не добавляет ему ничего. Проверка
    // verify-dist-structured-data-scale требует не объявлять БОЛЬШЕ
    // показанного; объявить меньше она разрешает, и это ровно тот случай.
    //
    // Берётся начало того же порядка, в котором страница показывает карточки,
    // поэтому список описывает именно то, что видно сверху.
    items: calculatorItems.slice(0, categoryItemListSize),
    // Плоская запись вместо вложенного WebApplication: адрес перестаёт
    // дублироваться внутри записи, а описание — повторять видимый текст
    // карточки. На ограниченном списке это устойчивые 0,25 КиБ.
    compact: true,
  }),
  faqJsonLd(category.faq),
  breadcrumbsJsonLd([
    { label: copy.home, href: localeHome(locale) },
    { label: category.name, href: categoryPath },
  ]),
];
---

<Layout
  title={category.seoTitle}
  description={category.seoDescription}
  canonical={categoryPath}
  locale={locale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="hero-mesh border-b border-ink-200" data-testid={`category-page-${category.slug}`}>
    <div class="mx-auto max-w-page px-5 pb-10 pt-9 sm:px-8 sm:pb-14 sm:pt-12">
      <Breadcrumbs
        label={pageCopy.breadcrumbs}
        items={[
          { label: copy.home, href: localeHome(locale) },
          { label: category.name },
        ]}
      />

      <div class="mt-5 flex min-w-0 flex-wrap items-baseline gap-3 sm:mt-6 sm:gap-4">
        <span class="text-fit text-xs uppercase tracking-wider text-ink-500">
          {calculators.length} {copy.instruments}
        </span>
      </div>

      <h1 class="mt-3 text-fit text-4xl font-extrabold leading-tight tracking-[-0.05em] text-ink-900 sm:text-5xl" data-testid="category-h1">
        {category.h1}
      </h1>
      <p class="mt-3 max-w-3xl text-fit text-base leading-relaxed text-ink-500 sm:mt-4 sm:text-lg">
        {category.longDescription}
      </p>

      <div class="mt-6 grid grid-cols-2 gap-2 sm:mt-8 sm:gap-3 lg:grid-cols-4" data-testid="category-hero-stats">
        <div class="meta-card">
          <div class="font-mono text-2xl font-semibold text-ink-900">{calculators.length}</div>
          <div class="mt-1 text-fit text-xs uppercase tracking-wider text-ink-500">{copy.instruments}</div>
        </div>
        <div class="meta-card">
          <div class="font-mono text-2xl font-semibold text-ink-900">{popularInCategory.length}</div>
          <div class="mt-1 text-fit text-xs uppercase tracking-wider text-ink-500">{copy.quickStart}</div>
        </div>
        <div class="meta-card">
          <div class="font-mono text-2xl font-semibold text-ink-900">{newInCategory.length}</div>
          <div class="mt-1 text-fit text-xs uppercase tracking-wider text-ink-500">{copy.newest}</div>
        </div>
        <div class="meta-card">
          <div class="font-mono text-2xl font-semibold text-ink-900">{category.faq.length}</div>
          <div class="mt-1 text-xs uppercase tracking-wider text-ink-500">FAQ</div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-2" data-testid="category-quick-links">
        {popularInCategory.map((calculator) => (
          <a href={calculator.fullPath} class="max-w-full rounded-xl bg-accent px-3 py-2 text-fit text-sm font-semibold leading-tight text-white shadow-sm transition-colors hover:bg-accent-600">
            {calculator.name}
          </a>
        ))}
        <a href="#all-calculators" class="max-w-full rounded-xl border border-ink-200 bg-white/70 px-3 py-2 text-fit text-sm font-semibold leading-tight text-ink-700 transition-colors hover:border-accent-100 hover:text-accent">
          {copy.allInSection}
        </a>
      </div>
    </div>
  </section>

  <section id="all-calculators" data-testid="category-list">
    <div class="mx-auto max-w-page px-5 py-10 sm:px-8 sm:py-14">
      <div class="mb-6 flex min-w-0 items-end justify-between gap-6 sm:mb-8">
        <h2 class="section-heading min-w-0 text-fit text-ink-900">{copy.allInSection}</h2>
        <a href={localeCatalog(locale)} class="shrink-0 text-sm font-medium text-accent underline-offset-4 hover:underline">
          {copy.allCalculators}
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {calculators.map((calculator) => (
          <CalculatorCard calc={calculator} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-ink-200 bg-white/50" data-testid="category-useful-links">
    <div class="mx-auto max-w-page px-5 py-8 sm:px-8 sm:py-10">
      <h2 class="text-fit text-2xl font-semibold tracking-tight text-ink-900">{usefulCopy.heading}</h2>
      <p class="mt-3 max-w-3xl text-fit text-sm leading-relaxed text-ink-600">{usefulCopy.intro}</p>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        <div class="content-card">
          <h3 class="font-semibold text-ink-900">{usefulCopy.popular}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {popularInCategory.map((calculator) => (
              <a href={calculator.fullPath} class="text-fit text-sm font-medium text-accent underline-offset-4 hover:underline">{calculator.name}</a>
            ))}
          </div>
        </div>
        <div class="content-card">
          <h3 class="font-semibold text-ink-900">{usefulCopy.newItems}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {(newInCategory.length > 0 ? newInCategory.slice(0, 3) : calculators.slice(-3)).map((calculator) => (
              <a href={calculator.fullPath} class="text-fit text-sm font-medium text-accent underline-offset-4 hover:underline">{calculator.name}</a>
            ))}
          </div>
        </div>
        <div class="content-card">
          <h3 class="font-semibold text-ink-900">{usefulCopy.other}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {otherCategories.map((item) => (
              <a href={`/${locale}/${item.slug}/`} class="text-fit text-sm font-medium text-accent underline-offset-4 hover:underline">{item.name}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-ink-200" data-testid="category-faq">
    <div class="mx-auto max-w-page px-5 py-8 sm:px-8 sm:py-12">
      <h2 class="mb-6 text-fit text-2xl font-semibold tracking-tight text-ink-900">{copy.faq}</h2>
      <FaqList items={category.faq} />
    </div>
  </section>

  <section class="border-t border-ink-200 bg-white/50" data-testid="category-other">
    <div class="mx-auto max-w-page px-5 py-8 sm:px-8 sm:py-12">
      <h2 class="mb-6 text-fit text-2xl font-semibold tracking-tight text-ink-900">{copy.categories}</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {otherCategories.map((item) => (
          <a href={`/${locale}/${item.slug}/`} class="min-w-0 rounded-2xl border border-ink-200 bg-white p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:border-accent-100 hover:shadow-md">
            <div class="text-fit font-medium text-ink-900">{item.name}</div>
            <p class="mt-1 line-clamp-3 text-fit text-xs leading-relaxed text-ink-500">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
