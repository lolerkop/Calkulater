---
import Layout from '../../components/Layout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import SearchBox from '../../components/islands/SearchBox.tsx';
import {
  getCategories,
  getPopularCalculators,
  getCalculators,
  localeCatalog,
  locales,
  ui,
  type Locale,
} from '../../lib/i18n';

// Страница «не найдено» для каждой публичной локали.
//
// Cloudflare отдаёт БЛИЖАЙШИЙ `404.html` вверх по дереву каталогов, поэтому
// наличия `/de/404.html` достаточно, чтобы немецкий посетитель получил немецкую
// страницу: ни правил в `_redirects`, ни воркера для этого не нужно. Корневой
// `/404.html` остаётся запасным вариантом для путей без локали.

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const locale = Astro.props.locale as Locale;
const copy = ui[locale];
const categories = getCategories(locale);
const calculators = getCalculators(locale);
const fallbackCalculators = getPopularCalculators(locale);

const notFound: Record<(typeof locales)[number], {
  title: string; description: string; heading: string; body: string;
  searchEyebrow: string; searchHeading: string; popular: string; seeAll: string;
}> = {
  ru: {
    title: 'Страница не найдена',
    description: 'К сожалению, такой страницы нет. Вернитесь на главную и продолжите подбор калькулятора.',
    heading: 'Страница не найдена',
    body: 'Возможно, адрес был указан неверно или калькулятор переехал в другую категорию. Откройте полный список инструментов или выберите нужный раздел ниже.',
    searchEyebrow: 'Поиск по сайту',
    searchHeading: 'Найдите нужный калькулятор',
    popular: 'Популярные калькуляторы',
    seeAll: 'Смотреть все',
  },
  en: {
    title: 'Page not found',
    description: 'This page does not exist. Go back to the home page and carry on picking a calculator.',
    heading: 'Page not found',
    body: 'The address may be wrong, or the calculator may have moved to another category. Open the full list of tools or pick a section below.',
    searchEyebrow: 'Search the site',
    searchHeading: 'Find the calculator you need',
    popular: 'Popular calculators',
    seeAll: 'See all',
  },
  uk: {
    title: 'Сторінку не знайдено',
    description: 'Такої сторінки немає. Поверніться на головну та продовжте добір калькулятора.',
    heading: 'Сторінку не знайдено',
    body: 'Можливо, адресу вказано неправильно або калькулятор переїхав до іншої категорії. Відкрийте повний перелік інструментів або оберіть потрібний розділ нижче.',
    searchEyebrow: 'Пошук по сайту',
    searchHeading: 'Знайдіть потрібний калькулятор',
    popular: 'Популярні калькулятори',
    seeAll: 'Дивитися всі',
  },
  de: {
    title: 'Seite nicht gefunden',
    description: 'Diese Seite gibt es nicht. Kehre zur Startseite zurück und such dir dort den passenden Rechner.',
    heading: 'Seite nicht gefunden',
    body: 'Vielleicht stimmt die Adresse nicht, oder der Rechner ist in eine andere Kategorie umgezogen. Öffne die vollständige Liste der Rechner oder wähle unten einen Bereich.',
    searchEyebrow: 'Suche auf der Website',
    searchHeading: 'Finde den passenden Rechner',
    popular: 'Beliebte Rechner',
    seeAll: 'Alle ansehen',
  },
};

const text = notFound[locale];
---

<Layout title={text.title} description={text.description} noindex locale={locale}>
  <section class="mx-auto max-w-page px-5 py-12 sm:px-8 sm:py-20" data-testid="page-404">
    <div class="hero-mesh grid min-w-0 gap-10 rounded-3xl border border-ink-200 p-6 shadow-lg lg:grid-cols-12 lg:items-end sm:p-10">
      <div class="min-w-0 lg:col-span-8">
        <div class="font-mono text-fit text-sm text-ink-500">/ 404</div>
        <h1 class="mt-3 text-fit text-5xl font-bold leading-none tracking-tightest text-ink-900 sm:text-6xl">
          {text.heading}
        </h1>
        <p class="mt-5 max-w-2xl text-fit text-base leading-relaxed text-ink-500 sm:text-lg">
          {text.body}
        </p>
      </div>
      <div class="min-w-0 lg:col-span-4 lg:text-right">
        <a href={localeCatalog(locale)} class="inline-flex btn-primary" data-testid="page-404-all-link">
          {copy.allCalculators}
        </a>
        <a
          href={`/${locale}/`}
          class="ml-3 inline-flex max-w-full rounded-xl border border-ink-200 bg-white px-5 py-3 text-center text-sm font-semibold leading-tight text-ink-900 transition-colors hover:border-accent-100 hover:text-accent"
          data-testid="page-404-home-link"
        >
          {copy.home}
        </a>
      </div>
    </div>

    <div class="mt-8 min-w-0 rounded-3xl border border-ink-200 bg-white p-5 shadow-sm sm:p-6" data-testid="page-404-search">
      <div class="mb-3 flex min-w-0 flex-wrap items-end justify-between gap-3">
        <div class="min-w-0">
          <div class="text-xs uppercase tracking-wider text-ink-500">{text.searchEyebrow}</div>
          <h2 class="mt-1 text-fit text-2xl font-semibold tracking-tight text-ink-900">
            {text.searchHeading}
          </h2>
        </div>
        <span class="font-mono text-fit text-xs text-ink-500">
          {calculators.length} {copy.instruments}
        </span>
      </div>
      <SearchBox locale={locale} client:idle />
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5" data-testid="page-404-categories">
      {categories.map((category) => (
        <a
          href={`/${locale}/${category.slug}/`}
          class="min-w-0 rounded-2xl border border-ink-200 bg-white p-4 text-fit text-sm font-semibold text-ink-900 shadow-sm transition-all hover:-translate-y-0.5 hover:border-accent-100 hover:text-accent"
        >
          {category.name}
        </a>
      ))}
    </div>

    <div class="mt-12" data-testid="page-404-popular">
      <div class="mb-5 flex min-w-0 items-end justify-between gap-6">
        <h2 class="min-w-0 text-fit text-2xl font-semibold tracking-tight text-ink-900">
          {text.popular}
        </h2>
        <a
          href={localeCatalog(locale)}
          class="hidden shrink-0 text-sm font-medium text-accent underline-offset-4 hover:underline sm:inline-flex"
        >
          {text.seeAll}
        </a>
      </div>
      <div class="grid gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
        {fallbackCalculators.map((calculator) => (
          <CalculatorCard calc={calculator} locale={locale} />
        ))}
      </div>
    </div>
  </section>
</Layout>
