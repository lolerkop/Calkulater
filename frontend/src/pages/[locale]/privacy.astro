---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { getAlternatesForPage, isLocale, localeHome, locales, ui, type Locale } from '../../lib/i18n';
import { breadcrumbsJsonLd, webPageJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const locale = (Astro.props.locale ?? 'ru') as Locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const language = locale === 'ru' || locale === 'uk' || locale === 'de' || locale === 'es' ? locale : 'en';
const copy = ui[locale];
const path = `/${locale}/privacy/`;
const updatedAt = '2026-10-03';
const privacyHref = SITE.privacyEmail ? `mailto:${SITE.privacyEmail}` : undefined;
const privacyLabel = SITE.privacyEmail || `/${locale}/contacts/#privacy`;

const pageCopy = {
  ru: {
    title: 'Политика конфиденциальности',
    description: 'Как Calcuway обрабатывает данные, ссылки с параметрами, технические журналы и согласие на аналитику.',
    breadcrumbs: 'Хлебные крошки',
    operator: SITE.legalName
      ? `Оператор сайта: ${SITE.legalName}${SITE.jurisdiction ? `, юрисдикция: ${SITE.jurisdiction}` : ''}.`
      : 'Сайт работает под названием Calcuway. Юридическое наименование оператора и юрисдикция пока не опубликованы.',
    sections: [
      ['operator', 'Владелец и оператор', 'Оператор отвечает за эту политику и настройки обработки данных на сайте.'],
      ['data', 'Какие данные обрабатываются', 'Формы калькуляторов могут содержать числа, даты, валюты и выбранные параметры. Регистрация, профиль и загрузка документов не используются.'],
      ['local', 'Локальные расчёты', 'Введённые значения обрабатываются JavaScript в вашем браузере и не отправляются серверу Calcuway для выполнения расчёта.'],
      ['share-links', 'Ссылки с параметрами', 'Только после нажатия «Скопировать ссылку» значения могут попасть в query-параметры URL. URL может сохраниться в истории, закладках, логах получателя или мессенджере. Не передавайте чувствительные значения. Для очистки удалите часть URL после знака ? или откройте калькулятор заново без параметров.'],
      ['storage', 'Cookies и хранилища браузера', 'Входные данные калькуляторов автоматически не сохраняются в localStorage или sessionStorage. Если аналитика настроена, выбор согласия хранится в localStorage под ключом calcuway.analytics-consent.v1. Собственный код сайта не устанавливает cookies до согласия.'],
      ['analytics', 'Аналитика и согласие', 'Google Analytics 4 и Яндекс Метрика загружаются только при наличии настроенных ID и после явного согласия. До согласия запросы к этим сервисам не выполняются. Согласие можно изменить через кнопку «Настройки приватности» или очистку данных сайта. Если эти ID не заданы, баннер согласия и оба этих сервиса отсутствуют. Обработка запросов инфраструктурой хостинга описана отдельно в разделе технических журналов.'],
      ['processors', 'Сторонние сервисы', 'Шрифты загружаются с Calcuway без обращения к Google Fonts. Google Analytics и Яндекс Метрика используются только после согласия. GitHub обрабатывает данные только если вы переходите в публичный канал поддержки. Хостинг и CDN предоставляет Cloudflare: её инфраструктура обрабатывает технические запросы для доставки и защиты сайта.'],
      ['logs', 'Технические журналы', 'Хостинг или CDN может фиксировать IP-адрес, User-Agent, время, запрошенный URL, статус ответа и ошибки. Query-параметры общей ссылки могут попасть в такие журналы, поэтому не помещайте в URL секретные данные.'],
      ['retention', 'Сроки хранения', 'Поля калькулятора не хранятся сервером Calcuway. Общая ссылка существует, пока она остаётся в истории, закладках или у получателя. Выбор аналитики хранится до очистки или смены версии ключа. Сроки журналов и данных сторонних сервисов определяются их настройками и политиками.'],
      ['rights', 'Права пользователя', 'В применимых случаях можно запросить доступ, исправление или удаление данных, возразить против обработки и отозвать согласие. Данные браузера и URL можно удалить самостоятельно в настройках браузера.'],
      ['contact', 'Контакт по приватности', SITE.privacyEmail ? 'Для приватного обращения используйте опубликованный email. Публичный GitHub-канал не подходит для персональных, финансовых или иных чувствительных данных.' : 'Отдельный приватный email пока не настроен. Не отправляйте персональные, финансовые или иные чувствительные данные через публичный GitHub-канал.'],
      ['updated', 'Дата обновления', `Политика обновлена ${updatedAt}.`],
      ['changes', 'Изменения политики', 'При изменении способов обработки новая версия публикуется на этой странице с новой датой обновления. Существенные изменения согласия не применяются задним числом.'],
    ],
  },
  en: {
    title: 'Privacy policy',
    description: 'How Calcuway handles calculator inputs, parameterized links, technical logs and analytics consent.',
    breadcrumbs: 'Breadcrumbs',
    operator: SITE.legalName
      ? `Site operator: ${SITE.legalName}${SITE.jurisdiction ? `; jurisdiction: ${SITE.jurisdiction}` : ''}.`
      : 'The site operates as Calcuway. The operator legal name and jurisdiction have not yet been published.',
    sections: [
      ['operator', 'Owner and operator', 'The operator is responsible for this policy and the site data-processing settings.'],
      ['data', 'Data processed', 'Calculator forms may contain numbers, dates, currencies and selected options. The site has no registration, user profiles or document uploads.'],
      ['local', 'Local calculations', 'Entered values are processed by JavaScript in your browser and are not sent to a Calcuway server to perform the calculation.'],
      ['share-links', 'Links with parameters', 'Only after you select Copy link may values be placed in URL query parameters. The URL may remain in browser history, bookmarks, recipient logs or messaging services. Do not include sensitive values. To reset it, remove everything after ? or reopen the calculator without parameters.'],
      ['storage', 'Cookies and browser storage', 'Calculator inputs are not automatically stored in localStorage or sessionStorage. When analytics is configured, the consent choice is stored in localStorage as calcuway.analytics-consent.v1. First-party code sets no cookies before consent.'],
      ['analytics', 'Analytics and consent', 'Google Analytics 4 and Yandex Metrica load only when valid IDs are configured and you explicitly consent. No requests to them occur before consent. Change the choice through Privacy settings or clear site data. Without those IDs, the consent banner and both services are absent. Request processing by the hosting infrastructure is described separately under Technical logs.'],
      ['processors', 'Third-party services', 'Fonts are served by Calcuway without a request to Google Fonts. Google Analytics and Yandex Metrica are used only after consent. GitHub processes data only when you open the public support channel. Hosting and CDN are provided by Cloudflare, whose infrastructure processes requests to deliver and protect the site.'],
      ['logs', 'Technical logs', 'The hosting service or CDN may record IP address, User-Agent, time, requested URL, response status and errors. Shared-link query parameters may therefore enter logs, so never place secrets in a URL.'],
      ['retention', 'Retention', 'Calcuway does not retain calculator fields on its server. A shared URL remains wherever it was saved or sent. The analytics choice remains until cleared or the storage-key version changes. Provider data and logs follow provider settings and policies.'],
      ['rights', 'Your rights', 'Where applicable, you may request access, correction or deletion, object to processing and withdraw consent. Browser storage and URLs can be removed locally in browser settings.'],
      ['contact', 'Privacy contact', SITE.privacyEmail ? 'Use the published email for private requests. The public GitHub channel is unsuitable for personal, financial or other sensitive information.' : 'A separate private email is not configured yet. Do not send personal, financial or other sensitive information through the public GitHub channel.'],
      ['updated', 'Last updated', `This policy was updated on ${updatedAt}.`],
      ['changes', 'Policy changes', 'Changes to processing are published here with a new update date. Material consent changes are not applied retroactively.'],
    ],
  },
  uk: {
    title: 'Політика конфіденційності',
    description: 'Як Calcuway обробляє дані калькуляторів, посилання з параметрами, технічні журнали та згоду на аналітику.',
    breadcrumbs: 'Навігаційний ланцюжок',
    operator: SITE.legalName
      ? `Оператор сайту: ${SITE.legalName}${SITE.jurisdiction ? `; юрисдикція: ${SITE.jurisdiction}` : ''}.`
      : 'Сайт працює під назвою Calcuway. Юридичну назву оператора та юрисдикцію ще не опубліковано.',
    sections: [
      ['operator', 'Власник і оператор', 'Оператор відповідає за цю політику та налаштування обробки даних на сайті.'],
      ['data', 'Які дані обробляються', 'Форми калькуляторів можуть містити числа, дати, валюти та вибрані параметри. Реєстрація, профілі й завантаження документів не використовуються.'],
      ['local', 'Локальні розрахунки', 'Введені значення обробляються JavaScript у вашому браузері й не надсилаються серверу Calcuway для виконання розрахунку.'],
      ['share-links', 'Посилання з параметрами', 'Лише після натискання «Скопіювати посилання» значення можуть потрапити до query-параметрів URL. URL може лишитися в історії, закладках, журналах одержувача чи месенджері. Не передавайте чутливі значення. Для очищення видаліть частину після ? або відкрийте калькулятор без параметрів.'],
      ['storage', 'Cookies і сховища браузера', 'Дані калькуляторів автоматично не зберігаються в localStorage або sessionStorage. Якщо аналітику налаштовано, вибір згоди зберігається в localStorage під ключем calcuway.analytics-consent.v1. Власний код не встановлює cookies до згоди.'],
      ['analytics', 'Аналітика та згода', 'Google Analytics 4 і Яндекс Метрика завантажуються лише за наявності налаштованих ID та після явної згоди. До згоди запити до цих сервісів не виконуються. Вибір можна змінити через «Налаштування приватності» або очищення даних сайту. Без цих ID банер згоди й обидва сервіси відсутні. Обробку запитів інфраструктурою хостингу описано окремо в розділі технічних журналів.'],
      ['processors', 'Сторонні сервіси', 'Шрифти завантажуються з Calcuway без звернення до Google Fonts. Google Analytics і Яндекс Метрика використовуються лише після згоди. GitHub обробляє дані лише після переходу в публічний канал підтримки. Хостинг і CDN надає Cloudflare: її інфраструктура обробляє технічні запити для доставки й захисту сайту.'],
      ['logs', 'Технічні журнали', 'Хостинг або CDN може фіксувати IP-адресу, User-Agent, час, URL, статус відповіді та помилки. Query-параметри спільного посилання можуть потрапити до журналів, тому не додавайте до URL секретні дані.'],
      ['retention', 'Строки зберігання', 'Calcuway не зберігає поля калькулятора на сервері. Спільний URL існує, доки його збережено або надіслано. Вибір аналітики зберігається до очищення чи зміни версії ключа. Дані провайдерів і журнали зберігаються за їхніми налаштуваннями.'],
      ['rights', 'Права користувача', 'У застосовних випадках можна запросити доступ, виправлення чи видалення, заперечити проти обробки та відкликати згоду. Дані браузера й URL можна видалити локально.'],
      ['contact', 'Контакт із питань приватності', SITE.privacyEmail ? 'Для приватного звернення використовуйте опублікований email. Публічний канал GitHub не підходить для персональних, фінансових чи інших чутливих даних.' : 'Окремий приватний email ще не налаштовано. Не надсилайте персональні, фінансові чи інші чутливі дані через публічний канал GitHub.'],
      ['updated', 'Дата оновлення', `Політику оновлено ${updatedAt}.`],
      ['changes', 'Зміни політики', 'Зміни способів обробки публікуються тут із новою датою. Істотні зміни згоди не застосовуються заднім числом.'],
    ],
  },
  de: {
    title: 'Datenschutzerklärung',
    description: 'Wie Calcuway mit Rechnereingaben, Links mit Parametern, technischen Protokollen und der Analyse-Einwilligung umgeht.',
    breadcrumbs: 'Brotkrumen',
    operator: SITE.legalName
      ? `Betreiber der Website: ${SITE.legalName}${SITE.jurisdiction ? `; Rechtsraum: ${SITE.jurisdiction}` : ''}.`
      : 'Die Website wird unter dem Namen Calcuway betrieben. Rechtlicher Name und Rechtsordnung des Betreibers sind noch nicht veröffentlicht.',
    sections: [
      ['operator', 'Inhaber und Betreiber', 'Der Betreiber verantwortet diese Erklärung und die Einstellungen zur Datenverarbeitung auf der Website.'],
      ['data', 'Verarbeitete Daten', 'Rechnerformulare können Zahlen, Daten, Währungen und ausgewählte Optionen enthalten. Die Website hat keine Registrierung, keine Nutzerprofile und keinen Dokumenten-Upload.'],
      ['local', 'Berechnung im Browser', 'Eingetragene Werte werden von JavaScript in deinem Browser verarbeitet und für die Berechnung nicht an einen Server von Calcuway gesendet.'],
      ['share-links', 'Links mit Parametern', 'Erst wenn du „Link kopieren“ wählst, können Werte als Abfrageparameter in die URL gelangen. Die URL kann im Browserverlauf, in Lesezeichen, in Protokollen des Empfängers oder in Messengern verbleiben. Trage dort keine sensiblen Werte ein. Zum Zurücksetzen entfernst du alles nach dem Fragezeichen oder öffnest den Rechner ohne Parameter erneut.'],
      ['storage', 'Cookies und Browserspeicher', 'Rechnereingaben werden nicht automatisch in localStorage oder sessionStorage abgelegt. Ist die Analyse konfiguriert, wird die Einwilligung als calcuway.analytics-consent.v1 in localStorage gespeichert. Eigener Code setzt vor der Einwilligung keine Cookies.'],
      ['analytics', 'Analyse und Einwilligung', 'Google Analytics 4 und Yandex Metrica werden nur mit konfigurierten IDs und nach ausdrücklicher Zustimmung geladen. Vor der Zustimmung erfolgen keine Anfragen an diese Dienste. Die Wahl lässt sich über die Datenschutzeinstellungen oder durch Löschen der Websitedaten ändern. Ohne diese IDs fehlen das Zustimmungsbanner und beide Dienste. Die Verarbeitung von Anfragen durch die Hosting-Infrastruktur wird unter Technische Protokolle getrennt beschrieben.'],
      ['processors', 'Dienste Dritter', 'Schriften werden von Calcuway ohne Anfrage an Google Fonts geladen. Google Analytics und Yandex Metrica werden nur nach Zustimmung verwendet. GitHub verarbeitet Daten erst beim Öffnen des öffentlichen Supportkanals. Hosting und CDN werden von Cloudflare bereitgestellt; die Infrastruktur verarbeitet Anfragen zur Auslieferung und zum Schutz der Website.'],
      ['logs', 'Technische Protokolle', 'Hosting oder CDN können IP-Adresse, User-Agent, Zeitpunkt, angeforderte URL, Antwortstatus und Fehler aufzeichnen. Abfrageparameter geteilter Links können damit in Protokolle gelangen — trage deshalb niemals Geheimnisse in eine URL ein.'],
      ['retention', 'Aufbewahrung', 'Calcuway bewahrt Rechnerfelder nicht auf seinem Server auf. Eine geteilte URL bleibt dort, wo sie gespeichert oder hingesendet wurde. Die Analyse-Auswahl bleibt bestehen, bis sie gelöscht wird oder sich die Version des Speicherschlüssels ändert. Daten und Protokolle der Anbieter richten sich nach deren Einstellungen und Richtlinien.'],
      ['rights', 'Deine Rechte', 'Soweit anwendbar kannst du Auskunft, Berichtigung oder Löschung verlangen, der Verarbeitung widersprechen und die Einwilligung widerrufen. Browserspeicher und URLs lassen sich lokal in den Browsereinstellungen entfernen.'],
      ['contact', 'Datenschutzkontakt', SITE.privacyEmail ? 'Nutze für private Anfragen die veröffentlichte E-Mail-Adresse. Der öffentliche GitHub-Kanal eignet sich nicht für personenbezogene, finanzielle oder andere sensible Daten.' : 'Eine separate private E-Mail-Adresse ist noch nicht eingerichtet. Sende keine personenbezogenen, finanziellen oder anderen sensiblen Daten über den öffentlichen GitHub-Kanal.'],
      ['updated', 'Letzte Aktualisierung', `Diese Erklärung wurde am ${updatedAt} aktualisiert.`],
      ['changes', 'Änderungen der Erklärung', 'Änderungen an der Verarbeitung werden hier mit einem neuen Aktualisierungsdatum veröffentlicht. Wesentliche Änderungen der Einwilligung wirken nicht rückwirkend.'],
    ],
  },
  es: {
    title: 'Política de privacidad',
    description: 'Cómo trata Calcuway los datos introducidos en las calculadoras, los enlaces con parámetros, los registros técnicos y el consentimiento de analítica.',
    breadcrumbs: 'Migas de pan',
    operator: SITE.legalName
      ? `Titular del sitio: ${SITE.legalName}${SITE.jurisdiction ? `; jurisdicción: ${SITE.jurisdiction}` : ''}.`
      : 'El sitio funciona como Calcuway. Todavía no se han publicado el nombre legal ni la jurisdicción del operador.',
    sections: [
      ['operator', 'Titular y responsable', 'El responsable del sitio responde de esta política y de los ajustes de tratamiento de datos del sitio.'],
      ['data', 'Datos tratados', 'Los formularios de las calculadoras pueden contener números, fechas, divisas y opciones seleccionadas. El sitio no tiene registro, ni perfiles de usuario, ni subida de documentos.'],
      ['local', 'Cálculo en el navegador', 'Los valores introducidos los procesa JavaScript en tu navegador y no se envían a ningún servidor de Calcuway para calcular.'],
      ['share-links', 'Enlaces con parámetros', 'Solo cuando eliges «copiar enlace» los valores pueden pasar a la URL como parámetros de consulta. Esa URL puede quedar en el historial del navegador, en los marcadores, en los registros de quien la reciba o en aplicaciones de mensajería. No introduzcas ahí valores sensibles. Para restablecerla, borra todo lo que sigue al signo de interrogación o vuelve a abrir la calculadora sin parámetros.'],
      ['storage', 'Cookies y almacenamiento del navegador', 'Lo que introduces en las calculadoras no se guarda automáticamente en localStorage ni en sessionStorage. Si la analítica está configurada, el consentimiento se guarda como calcuway.analytics-consent.v1 en localStorage. El código propio no coloca ninguna cookie antes del consentimiento.'],
      ['analytics', 'Analítica y consentimiento', 'Google Analytics 4 y Yandex Metrica se cargan solo con identificadores configurados y consentimiento explícito. Antes del consentimiento no se realizan solicitudes a estos servicios. La elección puede cambiarse en los ajustes de privacidad o borrando los datos del sitio. Sin esos identificadores no aparecen el aviso ni ambos servicios. El tratamiento de solicitudes por la infraestructura de alojamiento se describe por separado en Registros técnicos.'],
      ['processors', 'Servicios de terceros', 'Las fuentes se sirven desde Calcuway sin solicitar Google Fonts. Google Analytics y Yandex Metrica se utilizan solo tras el consentimiento. GitHub trata datos cuando abres el canal público de soporte. Cloudflare proporciona alojamiento y CDN; su infraestructura procesa solicitudes para entregar y proteger el sitio.'],
      ['logs', 'Registros técnicos', 'El alojamiento o la CDN pueden registrar la dirección IP, el agente de usuario, la marca de tiempo, la URL solicitada, el estado de la respuesta y los errores. Los parámetros de consulta de los enlaces compartidos pueden acabar así en esos registros: por eso nunca introduzcas secretos en una URL.'],
      ['retention', 'Conservación', 'Calcuway no conserva en su servidor los campos de las calculadoras. Una URL compartida permanece allí donde se haya guardado o enviado. La elección sobre analítica se mantiene hasta que se borra o cambia la versión de la clave de almacenamiento. Los datos y registros de los proveedores se rigen por sus propios ajustes y políticas.'],
      ['rights', 'Tus derechos', 'En la medida en que sea aplicable, puedes solicitar acceso, rectificación o supresión, oponerte al tratamiento y retirar tu consentimiento. El almacenamiento del navegador y las URL se pueden eliminar localmente desde los ajustes del navegador.'],
      ['contact', 'Contacto de privacidad', SITE.privacyEmail ? 'Utiliza el correo publicado para las solicitudes privadas. El canal público de GitHub no es adecuado para datos personales, financieros u otra información sensible.' : 'Todavía no se ha configurado un correo privado independiente. No envíes datos personales, financieros u otra información sensible por el canal público de GitHub.'],
      ['updated', 'Última actualización', `Esta política se actualizó el ${updatedAt}.`],
      ['changes', 'Cambios en la política', 'Los cambios en el tratamiento se publicarán aquí con una nueva fecha de actualización. Los cambios sustanciales del consentimiento no tienen efecto retroactivo.'],
    ],
  },
}[language];

const { title, description } = pageCopy;
const infrastructureAnalyticsCopy = {
  ru: 'На опубликованном сайте также работает Cloudflare Web Analytics: отдельный скрипт передаёт Cloudflare технические показатели загрузки страниц. Его работа определяется настройками хостинга и не управляется выбором согласия для Google Analytics и Яндекс Метрики. Сроки хранения и доступ к данным зависят от настроек и правил провайдера.',
  en: 'The published site also uses Cloudflare Web Analytics: a separate script sends technical page-load metrics to Cloudflare. It operates through hosting settings and is not controlled by the consent choice for Google Analytics and Yandex Metrica. Retention and access depend on the provider’s settings and policies.',
  uk: 'На опублікованому сайті також працює Cloudflare Web Analytics: окремий скрипт передає Cloudflare технічні показники завантаження сторінок. Його робота визначається налаштуваннями хостингу та не керується вибором згоди для Google Analytics і Яндекс Метрики. Строки зберігання та доступ до даних залежать від налаштувань і правил провайдера.',
  de: 'Die veröffentlichte Website nutzt auch Cloudflare Web Analytics: Ein separates Skript übermittelt technische Seitenlade-Messwerte an Cloudflare. Es wird über die Hosting-Einstellungen betrieben und nicht durch die Einwilligung für Google Analytics und Yandex Metrica gesteuert. Aufbewahrung und Zugriff hängen von den Einstellungen und Richtlinien des Anbieters ab.',
  es: 'El sitio publicado también utiliza Cloudflare Web Analytics: un script independiente envía a Cloudflare métricas técnicas de carga de páginas. Funciona mediante los ajustes de alojamiento y no depende del consentimiento para Google Analytics y Yandex Metrica. La conservación y el acceso dependen de los ajustes y políticas del proveedor.',
}[language];
const analyticsScopeCopy = {
  ru: 'Даже после согласия Google Analytics и Яндекс Метрика не загружаются на калькуляторах, главных страницах с поиском, в каталоге и на страницах ошибок. Они могут работать на страницах «О сайте», контактов, этой политики и категорий без полей ввода, если адрес страницы и источник перехода не содержат параметров или фрагментов. Собственные события сайта не включают значения полей калькуляторов. В явных вызовах адрес страницы передаётся без параметров и фрагмента, а источник перехода — только как домен. Эти ограничения относятся к интеграции GA/Яндекс в коде сайта; они не отменяют отдельную инфраструктурную обработку Cloudflare.',
  en: 'Even after consent, Google Analytics and Yandex Metrica do not load on calculators, home pages with search, the catalog or error pages. They may run on About, Contacts, this policy and category pages without input fields, provided the page URL and referrer have no query parameters or fragments. The site’s own events exclude calculator field values. Explicit calls send the page URL without parameters or a fragment and only the referrer origin. These restrictions concern the site’s GA/Yandex integration and do not remove the separate Cloudflare infrastructure processing.',
  uk: 'Навіть після згоди Google Analytics та Яндекс Метрика не завантажуються на калькуляторах, головних сторінках із пошуком, у каталозі та на сторінках помилок. Вони можуть працювати на сторінках «Про сайт», контактів, цієї політики та категорій без полів введення, якщо адреса сторінки та джерело переходу не містять параметрів або фрагментів. Власні події сайту не включають значення полів калькуляторів. У явних викликах адреса сторінки передається без параметрів і фрагмента, а джерело переходу — лише як домен. Ці обмеження стосуються інтеграції GA/Яндекс у коді сайту та не скасовують окремої інфраструктурної обробки Cloudflare.',
  de: 'Auch nach der Zustimmung werden Google Analytics und Yandex Metrica auf Rechnern, Startseiten mit Suche, im Katalog und auf Fehlerseiten nicht geladen. Sie können auf Über-uns-, Kontakt-, Datenschutz- und Kategorieseiten ohne Eingabefelder laufen, sofern Seitenadresse und Verweisquelle keine Suchparameter oder Fragmente enthalten. Eigene Ereignisse der Website enthalten keine Werte aus Rechnerfeldern. Explizite Aufrufe übermitteln die Seitenadresse ohne Parameter oder Fragment und nur den Ursprung der Verweisquelle. Diese Grenzen gelten für die GA/Yandex-Integration im Websitecode; die separate Verarbeitung durch die Cloudflare-Infrastruktur bleibt davon unberührt.',
  es: 'Incluso después del consentimiento, Google Analytics y Yandex Metrica no se cargan en las calculadoras, las páginas de inicio con búsqueda, el catálogo ni las páginas de error. Pueden funcionar en Acerca de, Contacto, esta política y las categorías sin campos de entrada, siempre que la dirección de la página y la referencia no contengan parámetros ni fragmentos. Los eventos propios del sitio no incluyen valores de los campos de las calculadoras. Las llamadas explícitas envían la dirección sin parámetros ni fragmento y solo el origen de la referencia. Estas restricciones corresponden a la integración GA/Yandex del sitio y no eliminan el tratamiento separado de la infraestructura de Cloudflare.',
}[language];
const alternates = getAlternatesForPage(Object.fromEntries(locales.map((item) => [item, `/${item}/privacy/`])));
const jsonLd = [
  webPageJsonLd({ name: title, description, path, locale }),
  breadcrumbsJsonLd([
    { label: copy.home, href: localeHome(locale) },
    { label: title, href: path },
  ]),
];
---

<Layout title={title} description={description} canonical={path} locale={locale} alternates={alternates} jsonLd={jsonLd}>
  <section class="hero-mesh border-b border-ink-200" data-testid="privacy-page">
    <div class="mx-auto max-w-page min-w-0 px-5 py-10 sm:px-8 sm:py-16">
      <Breadcrumbs label={pageCopy.breadcrumbs} items={[{ label: copy.home, href: localeHome(locale) }, { label: title }]} />
      <h1 class="mt-5 text-fit text-4xl font-extrabold tracking-[-0.05em] text-ink-900 sm:mt-6 sm:text-5xl">{title}</h1>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-ink-600">{pageCopy.operator}</p>
    </div>
  </section>
  <section class="border-b border-ink-200 bg-white/45">
    <div class="mx-auto grid max-w-page gap-4 px-5 py-10 sm:px-8 sm:py-14 md:grid-cols-2">
      {pageCopy.sections.map(([id, heading, text]) => (
        <article id={id} class="content-card scroll-mt-24" data-testid={`privacy-section-${id}`}>
          <h2 class="text-lg font-bold text-ink-900">{heading}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{text}</p>
          {id === 'analytics' && <p class="mt-2 text-sm leading-relaxed text-ink-600" data-testid="privacy-analytics-scope">{analyticsScopeCopy}</p>}
          {id === 'analytics' && <p class="mt-2 text-sm leading-relaxed text-ink-600" data-testid="privacy-infrastructure-analytics">{infrastructureAnalyticsCopy}</p>}
          {id === 'contact' && SITE.privacyEmail && (
            <a href={privacyHref} class="mt-3 inline-flex text-sm font-semibold text-accent underline underline-offset-4" data-testid="privacy-contact">
              {privacyLabel}
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>
