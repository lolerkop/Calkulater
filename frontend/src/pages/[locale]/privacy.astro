---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { getAlternatesForPage, isLocale, localeHome, locales, ui, type Locale } from '../../lib/i18n';
import { breadcrumbsJsonLd, webPageJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const locale = (Astro.props.locale ?? 'ru') as Locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const language = locale === 'ru' || locale === 'uk' || locale === 'de' ? locale : 'en';
const copy = ui[locale];
const path = `/${locale}/privacy/`;
const updatedAt = '2026-06-15';
const privacyHref = SITE.privacyEmail ? `mailto:${SITE.privacyEmail}` : `/${locale}/contacts/#privacy`;
const privacyLabel = SITE.privacyEmail || `/${locale}/contacts/#privacy`;

const pageCopy = {
  ru: {
    title: 'Политика конфиденциальности',
    description: 'Как Calcuway обрабатывает данные, ссылки с параметрами, технические журналы и согласие на аналитику.',
    breadcrumbs: 'Хлебные крошки',
    operator: SITE.legalName
      ? `Оператор сайта: ${SITE.legalName}${SITE.jurisdiction ? `, юрисдикция: ${SITE.jurisdiction}` : ''}.`
      : 'Сайт работает под названием Calcuway. Юридическое наименование оператора и юрисдикция пока не опубликованы; запрос можно направить через контакт для приватности.',
    sections: [
      ['operator', 'Владелец и оператор', 'Оператор отвечает за эту политику и настройки обработки данных на сайте.'],
      ['data', 'Какие данные обрабатываются', 'Формы калькуляторов могут содержать числа, даты, валюты и выбранные параметры. Регистрация, профиль и загрузка документов не используются.'],
      ['local', 'Локальные расчёты', 'Введённые значения обрабатываются JavaScript в вашем браузере и не отправляются серверу Calcuway для выполнения расчёта.'],
      ['share-links', 'Ссылки с параметрами', 'Только после нажатия «Скопировать ссылку» значения могут попасть в query-параметры URL. URL может сохраниться в истории, закладках, логах получателя или мессенджере. Не передавайте чувствительные значения. Для очистки удалите часть URL после знака ? или откройте калькулятор заново без параметров.'],
      ['storage', 'Cookies и хранилища браузера', 'Входные данные калькуляторов автоматически не сохраняются в localStorage или sessionStorage. Если аналитика настроена, выбор согласия хранится в localStorage под ключом calcuway.analytics-consent.v1. Собственный код сайта не устанавливает cookies до согласия.'],
      ['analytics', 'Аналитика и согласие', 'Google Analytics 4 и Яндекс Метрика загружаются только при наличии настроенных ID и после явного согласия. До согласия запросы к этим сервисам не выполняются. Согласие можно изменить через кнопку «Настройки приватности» или очистку данных сайта. Если эти ID не заданы, баннер согласия и оба этих сервиса отсутствуют. Отдельно от них работает Cloudflare Web Analytics: она включена на уровне инфраструктуры Cloudflare Pages и не зависит ни от указанных выше ID, ни от баннера согласия. Она помогает измерять посещаемость и производительность сайта и может собирать техническую информацию о загрузке и использовании страниц, включая метрики Web Vitals. По фактически проверенному поведению сайта она не устанавливает cookies и не записывает данные в localStorage или sessionStorage.'],
      ['processors', 'Сторонние сервисы', 'Шрифты загружаются с Calcuway без обращения к Google Fonts. Google Analytics и Яндекс Метрика используются только после согласия. GitHub обрабатывает данные только если вы переходите в публичный канал поддержки. Хостинг и CDN предоставляет Cloudflare: её инфраструктура обрабатывает технические запросы для доставки и защиты сайта, а также предоставляет Cloudflare Web Analytics.'],
      ['logs', 'Технические журналы', 'Хостинг или CDN может фиксировать IP-адрес, User-Agent, время, запрошенный URL, статус ответа и ошибки. Query-параметры общей ссылки могут попасть в такие журналы, поэтому не помещайте в URL секретные данные.'],
      ['retention', 'Сроки хранения', 'Поля калькулятора не хранятся сервером Calcuway. Общая ссылка существует, пока она остаётся в истории, закладках или у получателя. Выбор аналитики хранится до очистки или смены версии ключа. Сроки журналов и данных сторонних сервисов определяются их настройками и политиками.'],
      ['rights', 'Права пользователя', 'В применимых случаях можно запросить доступ, исправление или удаление данных, возразить против обработки и отозвать согласие. Данные браузера и URL можно удалить самостоятельно в настройках браузера.'],
      ['contact', 'Контакт по приватности', 'Для приватного обращения используйте указанный контакт. Публичный GitHub-канал не подходит для персональных, финансовых или иных чувствительных данных.'],
      ['updated', 'Дата обновления', `Политика обновлена ${updatedAt}.`],
      ['changes', 'Изменения политики', 'При изменении способов обработки новая версия публикуется на этой странице с новой датой обновления. Существенные изменения согласия не применяются задним числом.'],
    ],
  },
  en: {
    title: 'Privacy policy',
    description: 'How Calcuway handles calculator inputs, parameterized links, technical logs and analytics consent.',
    breadcrumbs: 'Breadcrumbs',
    operator: SITE.legalName
      ? `Site operator: ${SITE.legalName}${SITE.jurisdiction ? `; jurisdiction: ${SITE.jurisdiction}` : ''}.`
      : 'The site operates as Calcuway. The operator legal name and jurisdiction have not yet been published; use the privacy contact to request them.',
    sections: [
      ['operator', 'Owner and operator', 'The operator is responsible for this policy and the site data-processing settings.'],
      ['data', 'Data processed', 'Calculator forms may contain numbers, dates, currencies and selected options. The site has no registration, user profiles or document uploads.'],
      ['local', 'Local calculations', 'Entered values are processed by JavaScript in your browser and are not sent to a Calcuway server to perform the calculation.'],
      ['share-links', 'Links with parameters', 'Only after you select Copy link may values be placed in URL query parameters. The URL may remain in browser history, bookmarks, recipient logs or messaging services. Do not include sensitive values. To reset it, remove everything after ? or reopen the calculator without parameters.'],
      ['storage', 'Cookies and browser storage', 'Calculator inputs are not automatically stored in localStorage or sessionStorage. When analytics is configured, the consent choice is stored in localStorage as calcuway.analytics-consent.v1. First-party code sets no cookies before consent.'],
      ['analytics', 'Analytics and consent', 'Google Analytics 4 and Yandex Metrica load only when valid IDs are configured and you explicitly consent. No requests to them occur before consent. Change the choice through Privacy settings or clear site data. Without those IDs, the consent banner and both of those services are absent. Separately from them the site runs Cloudflare Web Analytics: it is enabled at the Cloudflare Pages infrastructure level and depends neither on the IDs above nor on the consent banner. It helps measure site traffic and performance and may collect technical information about how pages load and are used, including Web Vitals metrics. Based on the verified behaviour of the site, it sets no cookies and writes nothing to localStorage or sessionStorage.'],
      ['processors', 'Third-party services', 'Fonts are served by Calcuway without a request to Google Fonts. Google Analytics and Yandex Metrica are used only after consent. GitHub processes data only when you open the public support channel. Hosting and CDN are provided by Cloudflare: its infrastructure processes requests to deliver and protect the site and also provides Cloudflare Web Analytics.'],
      ['logs', 'Technical logs', 'The hosting service or CDN may record IP address, User-Agent, time, requested URL, response status and errors. Shared-link query parameters may therefore enter logs, so never place secrets in a URL.'],
      ['retention', 'Retention', 'Calcuway does not retain calculator fields on its server. A shared URL remains wherever it was saved or sent. The analytics choice remains until cleared or the storage-key version changes. Provider data and logs follow provider settings and policies.'],
      ['rights', 'Your rights', 'Where applicable, you may request access, correction or deletion, object to processing and withdraw consent. Browser storage and URLs can be removed locally in browser settings.'],
      ['contact', 'Privacy contact', 'Use the listed contact for privacy requests. The public GitHub support channel is unsuitable for personal, financial or other sensitive information.'],
      ['updated', 'Last updated', `This policy was updated on ${updatedAt}.`],
      ['changes', 'Policy changes', 'Changes to processing are published here with a new update date. Material consent changes are not applied retroactively.'],
    ],
  },
  uk: {
    title: 'Політика конфіденційності',
    description: 'Як Calcuway обробляє дані калькуляторів, посилання з параметрами, технічні журнали та згоду на аналітику.',
    breadcrumbs: 'Навігаційний ланцюжок',
    operator: SITE.legalName
      ? `Оператор сайту: ${SITE.legalName}${SITE.jurisdiction ? `; юрисдикція: ${SITE.jurisdiction}` : ''}.`
      : 'Сайт працює під назвою Calcuway. Юридичну назву оператора та юрисдикцію ще не опубліковано; їх можна запитати через контакт із питань приватності.',
    sections: [
      ['operator', 'Власник і оператор', 'Оператор відповідає за цю політику та налаштування обробки даних на сайті.'],
      ['data', 'Які дані обробляються', 'Форми калькуляторів можуть містити числа, дати, валюти та вибрані параметри. Реєстрація, профілі й завантаження документів не використовуються.'],
      ['local', 'Локальні розрахунки', 'Введені значення обробляються JavaScript у вашому браузері й не надсилаються серверу Calcuway для виконання розрахунку.'],
      ['share-links', 'Посилання з параметрами', 'Лише після натискання «Скопіювати посилання» значення можуть потрапити до query-параметрів URL. URL може лишитися в історії, закладках, журналах одержувача чи месенджері. Не передавайте чутливі значення. Для очищення видаліть частину після ? або відкрийте калькулятор без параметрів.'],
      ['storage', 'Cookies і сховища браузера', 'Дані калькуляторів автоматично не зберігаються в localStorage або sessionStorage. Якщо аналітику налаштовано, вибір згоди зберігається в localStorage під ключем calcuway.analytics-consent.v1. Власний код не встановлює cookies до згоди.'],
      ['analytics', 'Аналітика та згода', 'Google Analytics 4 і Яндекс Метрика завантажуються лише за наявності налаштованих ID та після явної згоди. До згоди запити не виконуються. Змініть вибір через «Налаштування приватності» або очистьте дані сайту. Без цих ID банера згоди та обох цих сервісів немає. Окремо від них працює Cloudflare Web Analytics: її увімкнено на рівні інфраструктури Cloudflare Pages, і вона не залежить ані від зазначених вище ID, ані від банера згоди. Вона допомагає вимірювати відвідуваність і продуктивність сайту та може збирати технічну інформацію про завантаження й використання сторінок, зокрема метрики Web Vitals. За фактично перевіреною поведінкою сайту вона не встановлює cookies і не записує дані в localStorage чи sessionStorage.'],
      ['processors', 'Сторонні сервіси', 'Шрифти завантажуються з Calcuway без звернення до Google Fonts. Google Analytics і Яндекс Метрика використовуються лише після згоди. GitHub обробляє дані тільки після переходу до публічної підтримки. Хостинг і CDN надає Cloudflare: її інфраструктура обробляє запити для доставки й захисту сайту, а також надає Cloudflare Web Analytics.'],
      ['logs', 'Технічні журнали', 'Хостинг або CDN може фіксувати IP-адресу, User-Agent, час, URL, статус відповіді та помилки. Query-параметри спільного посилання можуть потрапити до журналів, тому не додавайте до URL секретні дані.'],
      ['retention', 'Строки зберігання', 'Calcuway не зберігає поля калькулятора на сервері. Спільний URL існує, доки його збережено або надіслано. Вибір аналітики зберігається до очищення чи зміни версії ключа. Дані провайдерів і журнали зберігаються за їхніми налаштуваннями.'],
      ['rights', 'Права користувача', 'У застосовних випадках можна запросити доступ, виправлення чи видалення, заперечити проти обробки та відкликати згоду. Дані браузера й URL можна видалити локально.'],
      ['contact', 'Контакт із питань приватності', 'Використовуйте зазначений контакт. Публічний канал GitHub не підходить для персональних, фінансових чи інших чутливих даних.'],
      ['updated', 'Дата оновлення', `Політику оновлено ${updatedAt}.`],
      ['changes', 'Зміни політики', 'Зміни способів обробки публікуються тут із новою датою. Істотні зміни згоди не застосовуються заднім числом.'],
    ],
  },
  de: {
    title: 'Datenschutzerklärung',
    description: 'Wie Calcuway mit Rechnereingaben, Links mit Parametern, technischen Protokollen und der Analyse-Einwilligung umgeht.',
    breadcrumbs: 'Brotkrumen',
    operator: SITE.legalName
      ? `Betreiber der Website: ${SITE.legalName}${SITE.jurisdiction ? `; Rechtsraum: ${SITE.jurisdiction}` : ''}.`
      : 'Die Website wird unter dem Namen Calcuway betrieben. Der rechtliche Name des Betreibers und der Rechtsraum sind bisher nicht veröffentlicht; frage sie über den Datenschutzkontakt an.',
    sections: [
      ['operator', 'Inhaber und Betreiber', 'Der Betreiber verantwortet diese Erklärung und die Einstellungen zur Datenverarbeitung auf der Website.'],
      ['data', 'Verarbeitete Daten', 'Rechnerformulare können Zahlen, Daten, Währungen und ausgewählte Optionen enthalten. Die Website hat keine Registrierung, keine Nutzerprofile und keinen Dokumenten-Upload.'],
      ['local', 'Berechnung im Browser', 'Eingetragene Werte werden von JavaScript in deinem Browser verarbeitet und für die Berechnung nicht an einen Server von Calcuway gesendet.'],
      ['share-links', 'Links mit Parametern', 'Erst wenn du „Link kopieren“ wählst, können Werte als Abfrageparameter in die URL gelangen. Die URL kann im Browserverlauf, in Lesezeichen, in Protokollen des Empfängers oder in Messengern verbleiben. Trage dort keine sensiblen Werte ein. Zum Zurücksetzen entfernst du alles nach dem Fragezeichen oder öffnest den Rechner ohne Parameter erneut.'],
      ['storage', 'Cookies und Browserspeicher', 'Rechnereingaben werden nicht automatisch in localStorage oder sessionStorage abgelegt. Ist die Analyse konfiguriert, wird die Einwilligung als calcuway.analytics-consent.v1 in localStorage gespeichert. Eigener Code setzt vor der Einwilligung keine Cookies.'],
      ['analytics', 'Analyse und Einwilligung', 'Google Analytics 4 und Yandex Metrica laden nur, wenn gültige Kennungen konfiguriert sind und du ausdrücklich einwilligst. Vor der Einwilligung erfolgen keine Anfragen dorthin. Die Auswahl änderst du über die Datenschutzeinstellungen oder indem du die Websitedaten löschst. Ohne diese Kennungen fehlen sowohl der Einwilligungshinweis als auch beide Dienste. Unabhängig davon läuft Cloudflare Web Analytics: Es ist auf Infrastrukturebene von Cloudflare Pages aktiviert und hängt weder von den genannten Kennungen noch vom Einwilligungshinweis ab. Es hilft, Zugriffe und Leistung zu messen, und kann technische Angaben dazu erfassen, wie Seiten geladen und genutzt werden, einschließlich der Web-Vitals-Kennzahlen. Nach dem geprüften Verhalten der Website setzt es keine Cookies und schreibt nichts in localStorage oder sessionStorage.'],
      ['processors', 'Dienste Dritter', 'Schriften liefert Calcuway selbst aus, ohne Anfrage an Google Fonts. Google Analytics und Yandex Metrica kommen nur nach Einwilligung zum Einsatz. GitHub verarbeitet Daten nur, wenn du den öffentlichen Supportkanal öffnest. Hosting und CDN stellt Cloudflare bereit: Seine Infrastruktur verarbeitet Anfragen, um die Website auszuliefern und zu schützen, und stellt auch Cloudflare Web Analytics bereit.'],
      ['logs', 'Technische Protokolle', 'Hosting oder CDN können IP-Adresse, User-Agent, Zeitpunkt, angeforderte URL, Antwortstatus und Fehler aufzeichnen. Abfrageparameter geteilter Links können damit in Protokolle gelangen — trage deshalb niemals Geheimnisse in eine URL ein.'],
      ['retention', 'Aufbewahrung', 'Calcuway bewahrt Rechnerfelder nicht auf seinem Server auf. Eine geteilte URL bleibt dort, wo sie gespeichert oder hingesendet wurde. Die Analyse-Auswahl bleibt bestehen, bis sie gelöscht wird oder sich die Version des Speicherschlüssels ändert. Daten und Protokolle der Anbieter richten sich nach deren Einstellungen und Richtlinien.'],
      ['rights', 'Deine Rechte', 'Soweit anwendbar kannst du Auskunft, Berichtigung oder Löschung verlangen, der Verarbeitung widersprechen und die Einwilligung widerrufen. Browserspeicher und URLs lassen sich lokal in den Browsereinstellungen entfernen.'],
      ['contact', 'Datenschutzkontakt', 'Nutze für Datenschutzanfragen den angegebenen Kontakt. Der öffentliche Supportkanal auf GitHub eignet sich nicht für persönliche, finanzielle oder andere sensible Angaben.'],
      ['updated', 'Letzte Aktualisierung', `Diese Erklärung wurde am ${updatedAt} aktualisiert.`],
      ['changes', 'Änderungen der Erklärung', 'Änderungen an der Verarbeitung werden hier mit einem neuen Aktualisierungsdatum veröffentlicht. Wesentliche Änderungen der Einwilligung wirken nicht rückwirkend.'],
    ],
  },
}[language];

const { title, description } = pageCopy;
const alternates = getAlternatesForPage(Object.fromEntries(locales.map((item) => [item, `/${item}/privacy/`])));
const jsonLd = [
  webPageJsonLd({ name: title, description, path, locale }),
  breadcrumbsJsonLd([
    { label: copy.home, href: localeHome(locale) },
    { label: title, href: path },
  ]),
];
---

<Layout title={title} description={description} canonical={path} locale={locale} alternates={alternates} jsonLd={jsonLd}>
  <section class="hero-mesh border-b border-ink-200" data-testid="privacy-page">
    <div class="mx-auto max-w-page min-w-0 px-5 py-10 sm:px-8 sm:py-16">
      <Breadcrumbs label={pageCopy.breadcrumbs} items={[{ label: copy.home, href: localeHome(locale) }, { label: title }]} />
      <h1 class="mt-5 text-fit text-4xl font-extrabold tracking-[-0.05em] text-ink-900 sm:mt-6 sm:text-5xl">{title}</h1>
      <p class="mt-6 max-w-3xl text-base leading-relaxed text-ink-600">{pageCopy.operator}</p>
    </div>
  </section>
  <section class="border-b border-ink-200 bg-white/45">
    <div class="mx-auto grid max-w-page gap-4 px-5 py-10 sm:px-8 sm:py-14 md:grid-cols-2">
      {pageCopy.sections.map(([id, heading, text]) => (
        <article id={id} class="content-card scroll-mt-24" data-testid={`privacy-section-${id}`}>
          <h2 class="text-lg font-bold text-ink-900">{heading}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{text}</p>
          {id === 'contact' && (
            <a href={privacyHref} class="mt-3 inline-flex text-sm font-semibold text-accent underline underline-offset-4" data-testid="privacy-contact">
              {privacyLabel}
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>
