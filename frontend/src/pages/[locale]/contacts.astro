---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { getAlternatesForPage, isLocale, localeHome, locales, ui, type Locale } from '../../lib/i18n';
import { breadcrumbsJsonLd, webPageJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const locale = (Astro.props.locale ?? 'ru') as Locale;
if (!isLocale(locale)) return Astro.redirect('/404');
const copy = ui[locale];
const path = `/${locale}/contacts/`;
const pageCopy: Record<Locale, { title: string; description: string; lead: string; breadcrumbs: string }> = {
  ru: {
    title: 'Контакты',
    description: 'Контакты проекта онлайн-калькуляторов для вопросов, ошибок и предложений.',
    lead: 'Пишите, если нашли ошибку в расчете, хотите предложить новый калькулятор или уточнить данные на странице.',
    breadcrumbs: 'Хлебные крошки',
  },
  en: {
    title: 'Contacts',
    description: 'Contacts for questions, bug reports and calculator suggestions.',
    lead: 'Write if you found a calculation issue, want to suggest a new calculator or need to clarify page data.',
    breadcrumbs: 'Breadcrumbs',
  },
  es: {
    title: 'Contacto',
    description: 'Contacto para preguntas, errores de cálculo y sugerencias de nuevas calculadoras.',
    lead: 'Escríbenos si encontraste un error de cálculo, quieres sugerir una nueva calculadora o necesitas aclarar datos de una página.',
    breadcrumbs: 'Migas de pan',
  },
  de: {
    title: 'Kontakt',
    description: 'Kontakt für Fragen, Rechenfehler und Vorschläge für neue Rechner.',
    lead: 'Schreibe, wenn du einen Rechenfehler gefunden hast, einen neuen Rechner vorschlagen möchtest oder Seitendaten klären willst.',
    breadcrumbs: 'Breadcrumbs',
  },
  fr: {
    title: 'Contact',
    description: 'Contact pour questions, erreurs de calcul et suggestions de nouvelles calculatrices.',
    lead: 'Écrivez si vous avez trouvé une erreur de calcul, si vous voulez suggérer une nouvelle calculatrice ou clarifier les données d’une page.',
    breadcrumbs: 'Fil d’Ariane',
  },
  pt: {
    title: 'Contactos do projeto',
    description: 'Contacto para perguntas, erros de cálculo e sugestões de novas calculadoras.',
    lead: 'Escreva se encontrou um erro de cálculo, quer sugerir uma nova calculadora ou esclarecer dados de uma página.',
    breadcrumbs: 'Navegação estrutural',
  },
  it: {
    title: 'Contatti del progetto',
    description: 'Contatti per domande, errori di calcolo e suggerimenti di nuovi calcolatori.',
    lead: 'Scrivi se hai trovato un errore di calcolo, vuoi suggerire un nuovo calcolatore o chiarire i dati di una pagina.',
    breadcrumbs: 'Breadcrumb',
  },
  pl: {
    title: 'Kontakt',
    description: 'Kontakt w sprawie pytan, bledow obliczen i propozycji nowych kalkulatorow.',
    lead: 'Napisz, jesli znalazles blad w obliczeniach, chcesz zaproponowac nowy kalkulator albo wyjasnic dane na stronie.',
    breadcrumbs: 'Nawigacja okruszkowa',
  },
  nl: {
    title: 'Contact',
    description: 'Contact voor vragen, rekenfouten en suggesties voor nieuwe rekentools.',
    lead: 'Schrijf als je een rekenfout hebt gevonden, een nieuwe rekentool wilt voorstellen of paginadata wilt verduidelijken.',
    breadcrumbs: 'Kruimelpad',
  },
  ro: {
    title: 'Contact',
    description: 'Contact pentru intrebari, erori de calcul si sugestii de calculatoare noi.',
    lead: 'Scrie daca ai gasit o eroare de calcul, vrei sa propui un calculator nou sau sa clarifici datele unei pagini.',
    breadcrumbs: 'Breadcrumb',
  },
  id: {
    title: 'Kontak',
    description: 'Kontak untuk pertanyaan, kesalahan perhitungan, dan saran kalkulator baru.',
    lead: 'Tulis jika Anda menemukan kesalahan perhitungan, ingin mengusulkan kalkulator baru, atau perlu memperjelas data halaman.',
    breadcrumbs: 'Breadcrumb',
  },
  tr: {
    title: 'İletişim',
    description: 'Sorular, hesaplama hataları ve yeni hesaplayıcı önerileri için iletişim.',
    lead: 'Bir hesaplama hatası bulduysanız, yeni bir hesaplayıcı önermek istiyorsanız veya sayfa verilerini netleştirmek gerekiyorsa yazın.',
    breadcrumbs: 'Breadcrumb',
  },
  vi: {
    title: 'Liên hệ',
    description: 'Liên hệ cho câu hỏi, lỗi tính toán và đề xuất máy tính mới.',
    lead: 'Hãy viết nếu bạn thấy lỗi tính toán, muốn đề xuất máy tính mới hoặc cần làm rõ dữ liệu trên trang.',
    breadcrumbs: 'Breadcrumb',
  },
  cs: {
    title: 'Kontakt',
    description: 'Kontakt pro otázky, chyby výpočtů a návrhy nových kalkulaček.',
    lead: 'Napište, pokud jste našli chybu ve výpočtu, chcete navrhnout novou kalkulačku nebo potřebujete upřesnit data na stránce.',
    breadcrumbs: 'Drobečková navigace',
  },
  uk: {
    title: 'Контакти',
    description: 'Контакти для запитань, помилок розрахунків і пропозицій нових калькуляторів.',
    lead: 'Напишіть, якщо знайшли помилку в розрахунку, хочете запропонувати новий калькулятор або уточнити дані на сторінці.',
    breadcrumbs: 'Навігаційний ланцюжок',
  },
  sk: {
    title: 'Kontakt pre slovenské Kalkulačky',
    description: 'Kontakt pre otázky, chyby výpočtov a návrhy nových kalkulačiek.',
    lead: 'Napíšte, ak ste našli chybu vo výpočte, chcete navrhnúť novú kalkulačku alebo potrebujete upresniť dáta na stránke.',
    breadcrumbs: 'Omrvinková navigácia',
  },
  hu: {
    title: 'Kapcsolat',
    description: 'Kapcsolat kérdésekhez, számítási hibákhoz és új kalkulátorjavaslatokhoz.',
    lead: 'Írjon, ha számítási hibát talált, új kalkulátort javasolna, vagy pontosítaná az oldalon szereplő adatokat.',
    breadcrumbs: 'Morzsanavigáció',
  },
};

type ContactDetails = {
  channelTitle: string;
  channelText: string;
  channelAction: string;
  topicsTitle: string;
  publicChannelNote: string;
  topics: { id: string; title: string; text: string }[];
};

const contactDetails: Partial<Record<Locale, ContactDetails>> = {
  ru: {
    channelTitle: 'Как связаться',
    channelText: 'Опишите вопрос и добавьте ссылку на калькулятор, если обращение связано с расчётом.',
    channelAction: 'Открыть обращение',
    topicsTitle: 'С чем можно обратиться',
    publicChannelNote: 'Канал обращений публичный. Не указывайте в нём личные или финансовые данные.',
    topics: [
      { id: 'calculation-errors', title: 'Ошибки в расчётах', text: 'Укажите калькулятор, входные значения и ожидаемый результат.' },
      { id: 'data-questions', title: 'Вопросы по данным', text: 'Сообщите об устаревшей ставке, курсе, формуле или источнике.' },
      { id: 'privacy', title: 'Конфиденциальность', text: 'Задайте вопрос об обработке данных или политике конфиденциальности.' },
      { id: 'cooperation', title: 'Сотрудничество', text: 'Предложите новый калькулятор, источник данных или сотрудничество.' },
    ],
  },
  en: {
    channelTitle: 'How to contact us',
    channelText: 'Describe the question and include the calculator URL when the request concerns a calculation.',
    channelAction: 'Open a support request',
    topicsTitle: 'What you can contact us about',
    publicChannelNote: 'The support channel is public. Do not include personal or financial data.',
    topics: [
      { id: 'calculation-errors', title: 'Calculation errors', text: 'Include the calculator, input values and the result you expected.' },
      { id: 'data-questions', title: 'Data questions', text: 'Report an outdated rate, exchange rate, formula or source.' },
      { id: 'privacy', title: 'Privacy', text: 'Ask about data handling or the privacy policy.' },
      { id: 'cooperation', title: 'Cooperation', text: 'Suggest a calculator, data source or collaboration.' },
    ],
  },
  uk: {
    channelTitle: 'Як зв’язатися',
    channelText: 'Опишіть питання та додайте посилання на калькулятор, якщо звернення стосується розрахунку.',
    channelAction: 'Відкрити звернення',
    topicsTitle: 'З чим можна звернутися',
    publicChannelNote: 'Канал звернень публічний. Не вказуйте в ньому особисті чи фінансові дані.',
    topics: [
      { id: 'calculation-errors', title: 'Помилки в розрахунках', text: 'Вкажіть калькулятор, вхідні значення та очікуваний результат.' },
      { id: 'data-questions', title: 'Питання щодо даних', text: 'Повідомте про застарілу ставку, курс, формулу чи джерело.' },
      { id: 'privacy', title: 'Конфіденційність', text: 'Поставте питання про обробку даних чи політику конфіденційності.' },
      { id: 'cooperation', title: 'Співпраця', text: 'Запропонуйте новий калькулятор, джерело даних чи співпрацю.' },
    ],
  },
};

const details = contactDetails[locale] ?? contactDetails.en!;
const { title, description } = pageCopy[locale];
const alternates = getAlternatesForPage(Object.fromEntries(locales.map((locale) => [locale, `/${locale}/contacts/`])));
const jsonLd = [
  webPageJsonLd({ name: title, description, path, type: 'ContactPage', locale }),
  breadcrumbsJsonLd([
    { label: copy.home, href: localeHome(locale) },
    { label: title, href: path },
  ]),
];
const email = SITE.email;
const contactHref = email ? `mailto:${email}` : SITE.supportUrl;
const contactLabel = email || details.channelAction;
const privacyEmail = SITE.privacyEmail;
const privacyCopy = {
  ru: { action: 'Написать по вопросам приватности', unavailable: 'Отдельный приватный email пока не настроен. Публичный канал поддержки не используйте для чувствительных данных.' },
  en: { action: 'Contact us about privacy', unavailable: 'A private privacy email is not configured yet. Do not use the public support channel for sensitive information.' },
  uk: { action: 'Написати з питань приватності', unavailable: 'Окрему приватну email-адресу ще не налаштовано. Не використовуйте публічну підтримку для чутливих даних.' },
}[locale === 'ru' || locale === 'uk' ? locale : 'en'];
---

<Layout title={title} description={description} canonical={path} locale={locale} alternates={alternates} jsonLd={jsonLd}>
  <section class="hero-mesh border-b border-ink-200" data-testid="contacts-page">
    <div class="mx-auto max-w-page min-w-0 px-5 py-10 sm:px-8 sm:py-16">
      <Breadcrumbs label={pageCopy[locale].breadcrumbs} items={[{ label: copy.home, href: localeHome(locale) }, { label: title }]} />
      <h1 class="mt-5 text-fit text-4xl font-extrabold tracking-[-0.05em] text-ink-900 sm:mt-6 sm:text-5xl">{title}</h1>
      <p class="mt-6 max-w-2xl text-fit text-base leading-relaxed text-ink-600">
        {pageCopy[locale].lead}
      </p>
      <div class="mt-7 max-w-2xl rounded-2xl border border-white/80 bg-white/85 p-5 shadow-sm backdrop-blur">
        <h2 class="text-fit text-lg font-bold text-ink-900">{details.channelTitle}</h2>
        <p class="mt-2 text-fit text-sm leading-relaxed text-ink-600">{details.channelText}</p>
        <a href={contactHref} class="mt-4 inline-flex max-w-full rounded-xl bg-gradient-to-r from-accent to-sky px-5 py-3 text-center text-fit text-sm font-bold leading-tight text-white shadow-lg transition-transform hover:-translate-y-0.5" data-testid="contact-channel" data-analytics-event="contact_link_clicked">
          {contactLabel}
        </a>
        {!email && <p class="mt-3 text-fit text-xs leading-relaxed text-ink-500">{details.publicChannelNote}</p>}
      </div>
    </div>
  </section>

  <section class="border-b border-ink-200 bg-white/45" data-testid="contact-topics">
    <div class="mx-auto max-w-page px-5 py-10 sm:px-8 sm:py-14">
      <h2 class="section-heading text-fit text-ink-900">{details.topicsTitle}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {details.topics.map((topic) => (
          <article id={topic.id} class="content-card scroll-mt-24">
            <h3 class="text-fit text-lg font-semibold text-ink-900">{topic.title}</h3>
            <p class="mt-2 text-fit text-sm leading-relaxed text-ink-600">{topic.text}</p>
            {topic.id === 'privacy' && privacyEmail && (
              <a href={`mailto:${privacyEmail}`} class="mt-3 inline-flex text-sm font-semibold text-accent underline underline-offset-4" data-testid="privacy-contact-channel" data-analytics-event="contact_link_clicked">
                {privacyCopy.action}
              </a>
            )}
            {topic.id === 'privacy' && !privacyEmail && (
              <p class="mt-3 text-fit text-xs leading-relaxed text-ink-500" data-testid="privacy-contact-unavailable">{privacyCopy.unavailable}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
