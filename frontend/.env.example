# Optional canonical origin override. The production default is configured in code.
PUBLIC_SITE_URL=

# Optional contact email for service pages.
PUBLIC_CONTACT_EMAIL=
PUBLIC_PRIVACY_EMAIL=
PUBLIC_SUPPORT_URL=

# Optional legal operator details for the privacy policy.
PUBLIC_LEGAL_NAME=
PUBLIC_JURISDICTION=

# Optional analytics IDs. Leave empty to render no analytics scripts.
PUBLIC_GA_ID=
PUBLIC_YM_ID=

# Optional visual placeholders for future ad slots. Use true only while preparing ads.
PUBLIC_SHOW_AD_PLACEHOLDERS=
